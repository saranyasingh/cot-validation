fof(fact_1, axiom, flour_flour_ratio(3, 2)).

% --- RULES ---
fof(rule_1, axiom, ! [F, S] : (2 / 3 = F / S)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [F, G] : ((3 / 2 = 9 / G) => ? [H] : (H = 6))).

[tptp] Prover report:
