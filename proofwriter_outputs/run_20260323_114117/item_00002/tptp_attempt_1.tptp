% --- FACTS ---
fof(fact_1, axiom, green(the_bear)).
fof(fact_2, axiom, likes(the_bear, the_mouse)).
fof(fact_3, axiom, needs(the_bear, the_cow)).
fof(fact_4, axiom, needs(the_bear, the_mouse)).
fof(fact_5, axiom, sees(the_bear, the_cow)).
fof(fact_6, axiom, sees(the_bear, the_mouse)).
fof(fact_7, axiom, likes(the_cow, the_bear)).
fof(fact_8, axiom, sees(the_cow, the_bear)).
fof(fact_9, axiom, likes(the_mouse, the_cow)).
fof(fact_10, axiom, sees(the_mouse, the_rabbit)).
fof(fact_11, axiom, young(the_rabbit)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ( kind(X) => needs(X, the_bear) )).
fof(rule_2, axiom, ! [X] : ( sees(X, the_cow) => cold(X) )).
fof(rule_3, axiom, ! [X] : ( cold(X) => likes(X, the_rabbit) )).
fof(rule_4, axiom, ! [X] : ( needs(X, the_bear) => young(the_bear) )).
fof(rule_5, axiom, ! [X] : ( round(X) => likes(X, the_mouse) )).
fof(rule_6, axiom, ! [X] : ( (likes(X, the_bear) & likes(X, the_mouse)) => likes(the_bear, the_mouse) )).
fof(rule_7, axiom, ! [X] : ( likes(X, the_cow) => likes(the_cow, the_bear) )).
fof(rule_8, axiom, ! [X] : ( ( round(X) & ~ needs(X, the_bear) ) => sees(X, the_rabbit) )).

% --- INFERENCES ---
% From FACT-10 by Fact
fof(inf_1, axiom, sees(the_mouse, the_rabbit)).

% From FACT-10 by Negation Elimination
% From FACT-10, derive the negation of Sees(the_mouse, the_rabbit)
fof(inf_2, axiom, ~sees(the_mouse, the_rabbit)).