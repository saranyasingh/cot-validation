% --- FACTS ---
fof(fact_1, axiom, blue_fiber_bolts(robe, n_2)).
fof(fact_2, axiom, white_is_half_of_blue(robe)).
fof(fact_3, axiom, half(n_2, n_1)).
fof(fact_4, axiom, sum(n_2, n_1, n_3)).

% --- RULES ---
fof(rule_1, axiom, ! [R, X, Y] : ((blue_fiber_bolts(R, X) & white_is_half_of_blue(R) & half(X, Y)) => white_fiber_bolts(R, Y))).
fof(rule_2, axiom, ! [R, X, Y, Z] : ((blue_fiber_bolts(R, X) & white_fiber_bolts(R, Y) & sum(X, Y, Z)) => total_fiber_bolts(R, Z))).

% --- INFERENCES ---
% From fact_3 by Arithmetic Computation
fof(inf_1, axiom, half(n_2, n_1)).
% From fact_1, fact_2, inf_1, rule_1 by Modus Ponens
fof(inf_2, axiom, white_fiber_bolts(robe, n_1)).
% From fact_4 by Arithmetic Computation
fof(inf_3, axiom, sum(n_2, n_1, n_3)).
% From fact_1, inf_2, inf_3, rule_2 by Modus Ponens
fof(inf_4, axiom, total_fiber_bolts(robe, n_3)).