% --- FACTS ---
fof(fact_1, axiom, regular_rate(eliza, n_10)).
fof(fact_2, axiom, regular_hours_limit(eliza, n_40)).
fof(fact_3, axiom, overtime_multiplier(eliza, n_1_2)).
fof(fact_4, axiom, total_hours_worked(eliza, n_45)).
fof(fact_5, axiom, product(n_40, n_10, n_400)).
fof(fact_6, axiom, difference(n_45, n_40, n_5)).
fof(fact_7, axiom, product(n_1_2, n_10, n_12)).
fof(fact_8, axiom, product(n_5, n_12, n_60)).
fof(fact_9, axiom, sum(n_400, n_60, n_460)).

% --- RULES ---
fof(rule_1, axiom, ! [P, H, R, Z] : ((regular_hours_limit(P, H) & regular_rate(P, R) & product(H, R, Z)) => regular_pay(P, Z))).
fof(rule_2, axiom, ! [P, T, H, Z] : ((total_hours_worked(P, T) & regular_hours_limit(P, H) & difference(T, H, Z)) => overtime_hours(P, Z))).
fof(rule_3, axiom, ! [P, M, R, Z] : ((overtime_multiplier(P, M) & regular_rate(P, R) & product(M, R, Z)) => overtime_rate(P, Z))).
fof(rule_4, axiom, ! [P, H, R, Z] : ((overtime_hours(P, H) & overtime_rate(P, R) & product(H, R, Z)) => overtime_pay(P, Z))).
fof(rule_5, axiom, ! [P, X, Y, Z] : ((regular_pay(P, X) & overtime_pay(P, Y) & sum(X, Y, Z)) => total_earnings(P, Z))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_5, rule_1 by Modus Ponens
fof(inf_1, axiom, regular_pay(eliza, n_400)).
% From fact_2, fact_4, fact_6, rule_2 by Modus Ponens
fof(inf_2, axiom, overtime_hours(eliza, n_5)).
% From fact_1, fact_3, fact_7, rule_3 by Modus Ponens
fof(inf_3, axiom, overtime_rate(eliza, n_12)).
% From inf_2, inf_3, fact_8, rule_4 by Modus Ponens
fof(inf_4, axiom, overtime_pay(eliza, n_60)).
% From inf_1, inf_4, fact_9, rule_5 by Modus Ponens
fof(inf_5, axiom, total_earnings(eliza, n_460)).