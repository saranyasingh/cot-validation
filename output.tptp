% --- FACTS ---
fof(fact_1, axiom, bananas_in_collection(philip, 290)).
fof(fact_2, axiom, groups_of_bananas(philip, 2, equal_size)).

% --- RULES ---
fof(rule_1, axiom, ! [P] : ((bananas_in_collection(P, 290) & groups_of_bananas(P, 2, equal_size)) => group_size_per_group(P, 2, 145))).

% --- INFERENCES ---
% From fact_1, fact_2, and rule_1 by Modus Ponens
fof(inf_1, axiom, group_size_per_group(philip, 2, 145)).