% --- FACTS ---
fof(fact_1, axiom, hiked(4, t_1)).
fof(fact_2, axiom, hiked(2, t_1)).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (hiked(4, T) => hiked(4, T))).
fof(rule_2, axiom, ! [T] : (hiked(2, T) => hiked(2, T))).

% --- INFERENCES ---
% From fact_1, fact_2 by Arithmetic
fof(inf_1, axiom, remaining_distance(6)).
% From fact_1, fact_2 by Definition
fof(inf_2, axiom, desired_speed(4)).
% From fact_1, rule_1 by Calculation
fof(inf_3, axiom, total_trip_time(3)).
% From fact_2, rule_2 by Division
fof(inf_4, axiom, time_needed(1.5)).