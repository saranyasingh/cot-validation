% --- FACTS ---
fof(fact_1, axiom, regular_hours(40)).

% --- RULES ---
fof(rule_1, axiom, ! [Hours] : ((Hours * 10) => earnings_from_regular_hours(Hours))).
fof(rule_2, axiom, ! [Hours, Rate] : (((Hours - regular_hours(40)) * Rate) => earnings_from_overtime(Hours, Rate))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, earnings_from_regular_hours(40)).

% From fact_1, rule_2 by Modus Ponens
fof(inf_2, axiom, earnings_from_overtime(5, 12)).

% From fact_1, rule_1, rule_2 by Modus Ponens
fof(inf_3, axiom, total_earnings(hours)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_4, axiom, total_earnings(45)).