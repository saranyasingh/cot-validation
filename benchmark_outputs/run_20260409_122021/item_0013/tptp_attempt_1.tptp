% --- FACTS ---
fof(fact_1, axiom, initial_investment(90)).
fof(fact_2, axiom, annual_revenue(7 * 1.5)).
fof(fact_3, axiom, annual_expenses(3)).

% --- RULES ---
fof(rule_1, axiom, ! [N] : (net_profit_per_year(N) <=> (annual_revenue(N) - annual_expenses(N)))).
fof(rule_2, axiom, ! [N] : (cumulative_profit(N) <=> (N * net_profit_per_year(N)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, net_profit_per_year = ((7 * 1.5) - 3)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, cumulative_profit(n) = (4.5 * n)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_3, axiom, (4.5 * n) > 90).
% From inf_3 by Modus Ponens
fof(inf_4, axiom, n > 20).
% From inf_4 by Modus Ponens
fof(inf_5, axiom, n >= 21).