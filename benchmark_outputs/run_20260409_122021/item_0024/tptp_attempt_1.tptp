% --- FACTS ---
fof(fact_1, axiom, melt_rate(2, 1)).
fof(fact_2, axiom, duration(t_14, t_17)).

% --- RULES ---
fof(rule_1, axiom, ! [H] : ( melt_rate(H) => melted_by(H, 4) )).
fof(rule_2, axiom, ! [H, D] : ( height_decreases(H, H - melted_by(H, D)) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, melted_by(melt_rate(2, 1), 4)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, height_decreases(height, height - 8)).