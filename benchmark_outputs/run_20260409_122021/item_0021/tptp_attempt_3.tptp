% --- RULES ---
fof(rule_1, axiom, ! [X] : (AmountWater(orange_drink, X))).
fof(rule_2, axiom, ! [X] : (AmountWater(pineapple_drink, X))).
fof(rule_3, axiom, ! [X] : (RemainingWater(initial_water, X))).

