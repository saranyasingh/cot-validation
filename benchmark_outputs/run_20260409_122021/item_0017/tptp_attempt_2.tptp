% --- FACTS ---
fof(fact_1, axiom, traveled(train1, 80, t_1st_day)).
fof(fact_2, axiom, traveled(train2, 80, t_1st_day)).
fof(fact_3, axiom, traveled(train1, 150, t_2nd_day)).
fof(fact_4, axiom, traveled(train2, 150, t_2nd_day)).

% --- RULES ---
fof(rule_1, axiom, ! [X, D, T] : (traveled(X, D, T) <=> travels(X, D, T))).
fof(rule_2, axiom, ! [X, T] : (travelled_on_day(X, T) <=> ? [D] : traveled(X, D, T))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, traveled(train1, 80, t_1st_day)).
% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, traveled(train2, 80, t_1st_day)).
% From fact_3, rule_1 by Modus Ponens
fof(inf_3, axiom, traveled(train1, 150, t_2nd_day)).
% From fact_4, rule_1 by Modus Ponens
fof(inf_4, axiom, traveled(train2, 150, t_2nd_day)).

% Inference about total distances (symbolic representations)
fof(inf_5, axiom, total_distance(days, train1) = traveled(train1, 80, t_1st_day) + traveled(train1, 150, t_2nd_day)).
fof(inf_6, axiom, total_distance(days, train2) = traveled(train2, 80, t_1st_day) + traveled(train2, 150, t_2nd_day)).
fof(inf_7, axiom, sum_total_distance(train1) => total_distance(days, train1) = traveled(train1, 80, t_1st_day) + traveled(train1, 150, t_2nd_day)).
fof(inf_8, axiom, sum_total_distance(train2) => total_distance(days, train2) = traveled(train2, 80, t_1st_day) + traveled(train2, 150, t_2nd_day)).
fof(inf_9, axiom, combined_total_distance = total_distance(days, train1) + total_distance(days, train2)).
fof(inf_10, axiom, conclusion = 380).