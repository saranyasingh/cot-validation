% --- RULES ---
fof(rule_1, axiom, ! [X,D,A,H,T] : ((articles_written_on(X,D,A) & hours_per_article(X,H) & product(A,H,T)) => time_on_day(X,D,T))).
fof(rule_2, axiom, ! [X,P,Q,R,S] : ((time_on_day(X, monday, P) & time_on_day(X, tuesday, Q) & time_on_day(X, wednesday, R) & sum3(P,Q,R,S)) => total_time(X, S))).

% --- INFERENCES ---
% From FACT-1, FACT-2, FACT-8 via RULE-1
fof(inf_1, axiom, time_on_day(meredith, monday, n_20)).
% From FACT-4, FACT-9 via RULE-1
fof(inf_2, axiom, time_on_day(meredith, tuesday, n_28)).
