% --- FACTS ---
fof(fact_1, axiom, morning_emails(jack) = 6).
fof(fact_2, axiom, afternoon_emails(jack) = 2).

% --- RULES ---
fof(rule_1, axiom, ! [X] : (morning_emails(X) - afternoon_emails(X) = 4)).

% --- INFERENCES ---
% From fact_1, rule_1 by Subtraction
fof(inf_1, axiom, morning_emails(jack) - afternoon_emails(jack) = 4).