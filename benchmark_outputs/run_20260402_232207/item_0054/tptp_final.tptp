% --- FACTS ---
fof(fact_1, axiom, MorningEmails(jack) = 6).
fof(fact_2, axiom, AfternoonEmails(jack) = 2).

% --- RULES ---
fof(rule_1, axiom, ! [J] : (MorningEmails(J) - AfternoonEmails(J) = 4)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, MorningEmails(jack) - AfternoonEmails(jack) = 4).