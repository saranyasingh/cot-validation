% --- FACTS ---
fof(fact_1, axiom, t(school, students) = 270).

fof(fact_2, axiom, p(grade, students) = 5).

% --- RULES ---
fof(rule_1, axiom, ! [T] : ( number_of_grades = 270 / 5 )).

% --- INFERENCES ---
% From fact_1, fact_2, rule_1 by Rule-1
fof(inf_1, axiom, number_of_grades = 270 / 5).

% From inf_1 by Inference
fof(inf_2, axiom, number_of_grades = 54).