% --- FACTS ---
fof(fact_1, axiom, received_emails(morning)).
fof(fact_2, axiom, sent_letters(afternoon)).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (received_emails(T) | sent_letters(T))).
fof(rule_2, axiom, ! [T] : (member_of(T, morning) => sent_emails(T))).
fof(rule_3, axiom, ! [T] : (member_of(T, afternoon) => sent_emails(T)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [T] : (((member_of(T, morning) & received_emails(T)) | sent_emails(T)) & ((member_of(T, afternoon) & received_emails(T)) | sent_emails(T))) ).

% From fact_1, rule_2 by Modus Ponens
fof(inf_2, axiom, ? [T] : (member_of(T, morning) & sent_emails(T))).

% From fact_2, rule_3 by Modus Ponens
fof(inf_3, axiom, ? [T] : (member_of(T, afternoon) & sent_emails(T))).

% From fact_1, rule_1 by Modus Ponens
fof(inf_4, axiom, ? [T] : ( ((member_of(T, morning) & sent_emails(T)) | (member_of(T, afternoon) & sent_emails(T)) ) ) ).

% From fact_2, rule_2 by Modus Ponens
fof(inf_5, axiom, ? [T] : ( ((member_of(T, morning) & total_sent_emails(morning)) | (member_of(T, afternoon) & total_sent_emails(afternoon))) ) ).