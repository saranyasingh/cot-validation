% --- FACTS ---
fof(fact_1, axiom, learning_english(1)).
fof(fact_2, axiom, learning_chinese(1)).

% --- RULES ---
fof(rule_1, axiom, ! [D] : (learning_english(D) => learning_english_sum(D)) & ! [D] : (learning_chinese(D) => learning_chinese_sum(D))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, learning_english_sum(1) = 30).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, learning_chinese_sum(1) = 35).

% From fact_1, fact_2, rule_1 by Arithmetic
fof(inf_3, axiom, learning_english_sum(1) + learning_chinese_sum(1) = 65).