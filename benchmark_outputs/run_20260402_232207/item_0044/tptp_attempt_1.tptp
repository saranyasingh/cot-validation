% --- FACTS ---
fof(fact_1, axiom, games(kelly, t_initial)).

fof(fact_2, axiom, games(kelly, t_giveaway)).

% --- RULES ---
fof(rule_1, axiom, ! [G, T, A] : (games(G, T) => loss(G, T, A))).

% --- INFERENCES ---
% From fact_2, rule_1 by Modus Ponens
fof(inf_1, axiom, loss(kelly, t_giveaway, 64)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, remaining(games(kelly, t_final), t_final)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_3, axiom, remaining(games(kelly, t_final), t_final) = 42).