% --- FACTS ---
fof(fact_1, axiom, apps(15)).
fof(fact_2, axiom, added_apps(71)).
fof(fact_3, axiom, total_apps_after_addition(86)).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y, Z] : ( total_apps_after_addition(X) <=> ( ( apps(Y) & added_apps(Z) ) => X = apps(Y) + added_apps(Z) ) ) ).
fof(rule_2, axiom, ! [X, Y, Z] : ( remaining_apps(X) <=> ( ( total_apps_after_addition(Y) & deleted_apps(Z) ) => X = total_apps_after_addition(Y) - deleted_apps(Z) ) ) ).

% --- INFERENCES ---
% From fact_3, rule_2 by Modus Ponens
fof(inf_1, axiom, ! [X, Y, Z] : ( deleted_apps(X) <=> ( ( total_apps_after_addition(Y) & remaining_apps(Z) ) => X = total_apps_after_addition(Y) - remaining_apps(Z) ) ) ).
% From inf_1 by Definition
fof(inf_2, axiom, ! [X, Y, Z] : ( num_apps_deleted(X) <=> ( deleted_apps(Y) - added_apps(Z) ) ) ).
% From inf_2 by Fact
fof(inf_3, axiom, diff_apps_deleted_added(143)).