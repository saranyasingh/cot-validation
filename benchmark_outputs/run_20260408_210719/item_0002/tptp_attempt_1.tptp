% --- FACTS ---
fof(fact_1, axiom, blue_fiber = 2).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (total_bolts(T) = blue_fiber(T) + white_fiber(T))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [T] : (white_fiber(T) = 0.5 * blue_fiber(T))).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, ! [T] : (total_bolts(T) = blue_fiber(T) + white_fiber(T))).

% From fact_1 by Modus Ponens
fof(inf_3, axiom, ! [T] : (total_bolts(T) = 3)).