% --- RULES ---
fof(rule_1, axiom, ! [B] : (bus(B) => carrying(B, 30))).
fof(rule_2, axiom, ! [V] : (van(V) => carrying(V, 12))).
fof(rule_3, axiom, ! [B1, B2, B3, B4, B5] : ((bus(B1) & carrying(B1, 30) & bus(B2) & carrying(B2, 30) & bus(B3) & carrying(B3, 30) & bus(B4) & carrying(B4, 30) & bus(B5) & carrying(B5, 30)) => total_of_buses(150))).
fof(rule_4, axiom, ! [V1, V2, V3] : ((van(V1) & carrying(V1, 12) & van(V2) & carrying(V2, 12) & van(V3) & carrying(V3, 12)) => total_of_vans(36))).
fof(rule_5, axiom, ! [TB, TV] : ((total_of_buses(TB) & total_of_vans(TV) & TB = 150 & TV = 36 & all_students_in_buses_or_vans) => total_students(186))).

