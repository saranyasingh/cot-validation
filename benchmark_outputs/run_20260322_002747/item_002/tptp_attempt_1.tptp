% --- FACTS ---
fof(fact_1, axiom, total_books(three_hundred_sixty)).
fof(fact_2, axiom, shelves(nine)).
fof(fact_3, axiom, exists_p_for_equal_division(three_hundred_sixty, nine)).

% --- RULES ---
fof(rule_1, axiom, ! [T,N] : ( exists_p_for_equal_division(T,N) => ? [P] : ( product(T,N,P) & books_per_shelf(P) ) ) ).
fof(rule_2, axiom, ! [T,N,P] : ( product(T,N,P) => books_per_shelf(P) ) ).

% --- INFERENCES ---
% From fact_3, rule_1 by Modus Ponens
fof(inf_1, axiom, ? [P] : ( product(three_hundred_sixty, nine, P) & books_per_shelf(P) ) ).

% From inf_1, rule_2 by Modus Ponens
fof(inf_2, axiom, books_per_shelf(p)).

% From inf_2 by Arithmetic substitution (360 = 9 × 40)
fof(inf_3, axiom, books_per_shelf(forty)).