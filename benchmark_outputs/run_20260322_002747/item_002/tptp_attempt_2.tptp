% --- FACTS ---
fof(fact_1, axiom, total_books(360)).
fof(fact_2, axiom, shelves(9)).
fof(fact_3, axiom, product(360,9,40)).

% --- RULES ---
fof(rule_1, axiom, ! [T,N,P] : (product(T,N,P) => books_per_shelf(P))).

% --- INFERENCES ---
% From fact_3, rule_1 by Modus Ponens
fof(inf_1, axiom, books_per_shelf(40)).