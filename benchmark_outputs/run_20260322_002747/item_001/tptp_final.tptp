% --- FACTS ---
fof(fact_1, axiom, bananatotal(bananas_290)).

fof(fact_2, axiom, bananagroups(groups_2)).

% --- RULES ---
fof(rule_1, axiom, ! [N] : ! [G] : ((bananatotal(N) & bananagroups(G)) => ? [S] : (group_size(N, G, S) & quotient(N, G, S)))).

% --- INFERENCES ---
% From FACT-1, FACT-2, RULE-1 by Universal Instantiation and Existential Introduction
fof(inf_1, axiom, ? [S] : (group_size(bananas_290, groups_2, S) & quotient(bananas_290, groups_2, S))).