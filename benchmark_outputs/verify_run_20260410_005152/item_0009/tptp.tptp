fof(fact_17, axiom, product(n_80, n_1_5, n_120)).

% --- RULES ---
fof(rule_1, axiom, ! [P,S,T,D] : ((speed(P,S) & time(P,T) & product(S,T,D)) => distance(P,D))).

% --- INFERENCES ---
% From FACT-1, FACT-2, FACT-15 via RULE-1 (Modus Ponens)
fof(inf_1, axiom, distance(john, n_180)).
% From FACT-6, FACT-7, FACT-16 via RULE-1 (Modus Ponens)
fof(inf_2, axiom, distance(john, n_15)).
% From FACT-11, FACT-12, FACT-17 via RULE-1 (Modus Ponens)
fof(inf_3, axiom, distance(john, n_120)).
% From FACT-3, INF-2, INF-3 via RULE-2
fof(inf_4, axiom, total_distance(john, n_315)).