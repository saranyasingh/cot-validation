% --- FACTS ---
fof(fact_1, axiom, speed(john, n_60)).
fof(fact_2, axiom, time(john, n_3)).
fof(fact_3, axiom, distance(john, n_180)).
fof(fact_4, axiom, return_window(john, n_4)).
fof(fact_5, axiom, stuck_in_traffic(john, n_2)).
fof(fact_6, axiom, speed(john, n_30)).
fof(fact_7, axiom, time(john, n_0_5)).
fof(fact_8, axiom, distance(john, n_15)).
fof(fact_9, axiom, remaining_distance(john, n_165)).
fof(fact_10, axiom, remaining_time(john, n_1_5)).
fof(fact_11, axiom, speed(john, n_80)).
fof(fact_12, axiom, time(john, n_1_5)).
fof(fact_13, axiom, distance(john, n_120)).
fof(fact_14, axiom, total_distance(john, n_315)).
fof(fact_15, axiom, product(n_60, n_3, n_180)).
