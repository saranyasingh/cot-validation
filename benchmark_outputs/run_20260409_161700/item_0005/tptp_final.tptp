% --- FACTS ---
fof(fact_1, axiom, daily_feed_per_chicken(n_3)).
fof(fact_2, axiom, chickens(n_20)).
fof(fact_3, axiom, morning_feed(n_15)).
fof(fact_4, axiom, afternoon_feed(n_25)).
fof(fact_5, axiom, multiply(n_3, n_20, n_60)).
fof(fact_6, axiom, add(n_15, n_25, n_40)).
fof(fact_7, axiom, subtract(n_60, n_40, n_20)).

% --- RULES ---
fof(rule_1, axiom, ! [P, C, T] : ((daily_feed_per_chicken(P) & chickens(C) & multiply(P, C, T)) => total_feed(T))).
fof(rule_2, axiom, ! [M, A, S] : ((morning_feed(M) & afternoon_feed(A) & add(M, A, S)) => sum_morning_afternoon(S))).
fof(rule_3, axiom, ! [T, S, R] : ((total_feed(T) & sum_morning_afternoon(S) & subtract(T, S, R)) => remaining_feed(R))).
fof(rule_4, axiom, ! [R] : (remaining_feed(R) => final_answer(R))).

% --- INFERENCES ---
% From FACT-1, FACT-2, and FACT-5 by Modus Ponens
fof(inf_1, axiom, total_feed(n_60)).
% From FACT-3, FACT-4, FACT-6 by Modus Ponens
fof(inf_2, axiom, sum_morning_afternoon(n_40)).
% From INF-1 and INF-2 by ArithmeticComputation
fof(inf_3, axiom, subtract(n_60, n_40, n_20)).
% From INF-3 by RULE-3
fof(inf_4, axiom, remaining_feed(n_20)).
% From INF-4 by RULE-4
fof(inf_5, axiom, final_answer(n_20)).