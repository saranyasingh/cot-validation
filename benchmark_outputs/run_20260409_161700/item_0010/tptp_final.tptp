% --- FACTS ---
fof(fact_1, axiom, hourly_rate(eliza, n_10)).
fof(fact_2, axiom, regular_hours(eliza, n_40)).
fof(fact_3, axiom, overtime_rate(eliza, n_12)).
fof(fact_4, axiom, overtime_hours(eliza, n_5)).
fof(fact_5, axiom, multiply(n_10, n_40, n_400)).
fof(fact_6, axiom, multiply(n_12, n_5, n_60)).
fof(fact_7, axiom, add(n_400, n_60, n_460)).

% --- RULES ---
fof(rule_1, axiom, ! [P, R, H, B] : ((hourly_rate(P, R) & regular_hours(P, H) & multiply(R, H, B)) => base_pay(P, B))).
fof(rule_2, axiom, ! [P, R, H, O] : ((overtime_rate(P, R) & overtime_hours(P, H) & multiply(R, H, O)) => overtime_pay(P, O))).
fof(rule_3, axiom, ! [P, B, O, T] : ((base_pay(P, B) & overtime_pay(P, O) & add(B, O, T)) => total_earnings(P, T))).

% --- INFERENCES ---
% From FACT-1, FACT-2, FACT-5 by RULE-1
fof(inf_1, axiom, base_pay(eliza, n_400)).
% From FACT-3, FACT-4, FACT-6 by RULE-2
fof(inf_2, axiom, overtime_pay(eliza, n_60)).
% From INF-1, INF-2, FACT-7 by RULE-3
fof(inf_3, axiom, total_earnings(eliza, n_460)).