% --- FACTS ---
fof(fact_1, axiom, earned(money_10, 40, t_24)).
fof(fact_2, axiom, earned(money_12, 5, t_24)).

% --- RULES ---
fof(rule_1, axiom, ! [N, T] : (earned(money_10, N, T) => total_earnings(N, money_10, T))).
fof(rule_2, axiom, ! [M, T] : (earned(money_12, M, T) => total_earnings(M, money_12, T))).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, total_earnings(40, money_10, t_24)).
% From FACT-2, RULE-2 by Modus Ponens
fof(inf_2, axiom, total_earnings(5, money_12, t_24)).
% From inf_1, inf_2 by addition
fof(inf_3, axiom, total_earnings(40, money_10, t_24) + total_earnings(5, money_12, t_24)).
% From inf_3 by equality to the weekly total
fof(inf_4, axiom, total_earnings(40, money_10, t_24) + total_earnings(5, money_12, t_24) = 460).