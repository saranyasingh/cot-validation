% --- FACTS ---
fof(fact_1, axiom, decision_to_run(3, 3)).

fof(fact_2, axiom, sprint_length(60)).

% --- RULES ---
fof(rule_1, axiom, ! [N, L, M] : (multiplication_rule(N, L, M))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, multiplication_rule(3, 60, total_meters_per_session)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, multiplication_rule(total_meters_per_session, 3, total_meters_per_week)).