% OP-1: Quotient(2, 2, 1)
tff(op_1, conjecture, $quotient(2/1, 2/1) = 1/1).
% OP-2: Product(2, 1, 2)
tff(op_2, conjecture, $product(2/1, 1/1) = 2/1).
% OP-3: Difference(200, 2, 198)
tff(op_3, conjecture, $difference(200/1, 2/1) = 198/1).
% OP-4: Difference(1, 0.4, 0.6)
tff(op_4, conjecture, ($lesseq($difference($difference(1/1, 2/5), 3/5), 1/20) & $lesseq($difference(3/5, $difference(1/1, 2/5)), 1/20))).
% OP-5: Product(2, 0.6, 1.2)
tff(op_5, conjecture, ($lesseq($difference($product(2/1, 3/5), 6/5), 1/20) & $lesseq($difference(6/5, $product(2/1, 3/5)), 1/20))).
% OP-6: Quotient(198, 1.2, 165)
tff(op_6, conjecture, $quotient(198/1, 6/5) = 165/1).
% OP-7: Sum(1, 165, 166)
tff(op_7, conjecture, $sum(1/1, 165/1) = 166/1).