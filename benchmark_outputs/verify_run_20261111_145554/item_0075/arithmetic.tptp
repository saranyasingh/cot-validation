% OP-4: Sum(32.88, 16.83, 36.04, 85.75)
tff(op_4, conjecture, ($lesseq($difference($sum($sum(822/25, 1683/100), 901/25), 343/4), 1/200) & $lesseq($difference(343/4, $sum($sum(822/25, 1683/100), 901/25)), 1/200))).