% OP-1: Product(2.74, 12, 32.88)
tff(op_1, conjecture, ($lesseq($difference($product(137/50, 12/1), 822/25), 1/200) & $lesseq($difference(822/25, $product(137/50, 12/1)), 1/200))).
% OP-2: Product(1.87, 9, 16.83)
tff(op_2, conjecture, ($lesseq($difference($product(187/100, 9/1), 1683/100), 1/200) & $lesseq($difference(1683/100, $product(187/100, 9/1)), 1/200))).
