% --- FACTS ---
fof(fact_1, axiom, bought(mishka, shorts, n_3)).
fof(fact_2, axiom, price_per_unit(shorts, n_16_50)).
fof(fact_3, axiom, bought(mishka, pants, n_3)).
fof(fact_4, axiom, price_per_unit(pants, n_22_50)).
fof(fact_5, axiom, bought(mishka, shoes, n_3)).
fof(fact_6, axiom, price_per_unit(shoes, n_42)).

% --- OPERATIONS ---
fof(op_1, axiom, product(n_3, n_16_50, n_49_50)).
fof(op_2, axiom, product(n_3, n_22_50, n_67_50)).
fof(op_3, axiom, product(n_3, n_42, n_126)).
fof(op_4, axiom, sum(n_49_50, n_67_50, n_126, n_243)).

% --- RULES ---
fof(rule_1, axiom, ! [X,I,N,P,C] : ((bought(X, I, N) & price_per_unit(I, P) & product(N, P, C)) => total_cost(X, I, C))).
fof(rule_2, axiom, ! [X,I1,I2,I3,C1,C2,C3,S] : ((total_cost(X, I1, C1) & total_cost(X, I2, C2) & total_cost(X, I3, C3) & sum(C1, C2, C3, S)) => total_spent(X, S))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, total_cost(mishka, shorts, n_49_50)).
% From fact_3, fact_4, op_2, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, total_cost(mishka, pants, n_67_50)).
% From fact_5, fact_6, op_3, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_3, axiom, total_cost(mishka, shoes, n_126)).
% From inf_1, inf_2, inf_3, op_4, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_4, axiom, total_spent(mishka, n_243)).