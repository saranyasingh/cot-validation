% OP-1: Difference(4, 2, 2)
tff(op_1, conjecture, $difference(4/1, 2/1) = 2/1).
% OP-2: Product(60, 3, 180)
tff(op_2, conjecture, $product(60/1, 3/1) = 180/1).
% OP-3: Product(30, 2, 60)
tff(op_3, conjecture, $product(30/1, 2/1) = 60/1).
% OP-4: Sum(180, 60, 240)
tff(op_4, conjecture, $sum(180/1, 60/1) = 240/1).