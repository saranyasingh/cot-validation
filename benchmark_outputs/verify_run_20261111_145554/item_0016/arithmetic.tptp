% OP-1: Product(5000, 0.025, 125)
tff(op_1, conjecture, $product(5000/1, 1/40) = 125/1).
% OP-2: Sum(5000, 125, 5125)
tff(op_2, conjecture, $sum(5000/1, 125/1) = 5125/1).
% OP-3: Product(8000, 0.012, 96)
tff(op_3, conjecture, $product(8000/1, 3/250) = 96/1).
% OP-4: Sum(8000, 96, 8096)
tff(op_4, conjecture, $sum(8000/1, 96/1) = 8096/1).
% OP-5: Difference(5125, 5000, 125)
tff(op_5, conjecture, $difference(5125/1, 5000/1) = 125/1).
% OP-6: Difference(8096, 8000, 96)
tff(op_6, conjecture, $difference(8096/1, 8000/1) = 96/1).
% OP-7: Difference(125, 96, 29)
tff(op_7, conjecture, $difference(125/1, 96/1) = 29/1).