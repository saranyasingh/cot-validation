% OP-1: Product(0.5, 3, 1.5)
tff(op_1, conjecture, ($lesseq($difference($product(1/2, 3/1), 3/2), 1/20) & $lesseq($difference(3/2, $product(1/2, 3/1)), 1/20))).
% OP-2: Sum(3, 1.5, 1.5, 6)
tff(op_2, conjecture, $sum($sum(3/1, 3/2), 3/2) = 6/1).
% OP-3: Quotient(60, 6, 10)
tff(op_3, conjecture, $quotient(60/1, 6/1) = 10/1).