% --- FACTS ---
fof(fact_1, axiom, eggs_per_day(lloyd, n_252)).
fof(fact_2, axiom, price_per_dozen(lloyd, n_2)).

% --- OPERATIONS ---
fof(op_1, axiom, quotient(n_252, n_12, n_21)).
fof(op_2, axiom, product(n_21, n_2, n_42)).
fof(op_3, axiom, product(n_42, n_7, n_294)).

% --- RULES ---
fof(rule_1, axiom, ! [X,E,D] : ((eggs_per_day(X, E) & quotient(E, n_12, D)) => dozens_per_day(X, D))).
fof(rule_2, axiom, ! [X,D,P,R] : ((dozens_per_day(X, D) & price_per_dozen(X, P) & product(D, P, R)) => earns_per_day(X, R))).
fof(rule_3, axiom, ! [X,R,W] : ((earns_per_day(X, R) & product(R, n_7, W)) => earns_per_week(X, W))).

% --- INFERENCES ---
% From fact_1, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, dozens_per_day(lloyd, n_21)).
% From inf_1, fact_2, op_2, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, earns_per_day(lloyd, n_42)).
% From inf_2, op_3, rule_3 by Universal Instantiation and Modus Ponens
fof(inf_3, axiom, earns_per_week(lloyd, n_294)).