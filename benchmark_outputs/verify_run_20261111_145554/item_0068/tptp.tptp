% --- FACTS ---
fof(fact_1, axiom, count(diamond, n_175)).
fof(fact_2, axiom, fewer_by(ruby, diamond, n_35)).
fof(fact_3, axiom, twice(emerald, ruby)).

% --- OPERATIONS ---
fof(op_1, axiom, difference(n_175, n_35, n_140)).
fof(op_2, axiom, product(n_2, n_140, n_280)).
fof(op_3, axiom, sum(n_175, n_140, n_280, n_595)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,N,M,R] : ((count(Y, M) & fewer_by(X, Y, N) & difference(M, N, R)) => count(X, R))).
fof(rule_2, axiom, ! [X,Y,M,R] : ((count(Y, M) & twice(X, Y) & product(n_2, M, R)) => count(X, R))).
fof(rule_3, axiom, ! [X,Y,Z,A,B,C,S] : ((count(X, A) & count(Y, B) & count(Z, C) & sum(A, B, C, S)) => total(chest, S))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, count(ruby, n_140)).
% From inf_1, fact_3, op_2, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, count(emerald, n_280)).
% From fact_1, inf_1, inf_2, op_3, rule_3 by Universal Instantiation and Modus Ponens
fof(inf_3, axiom, total(chest, n_595)).