% --- FACTS ---
fof(fact_1, axiom, sheep(seattle, n_20)).
fof(fact_2, axiom, times_as_many(charleston, seattle, n_4)).
fof(fact_3, axiom, times_as_many(toulouse, charleston, n_2)).

% --- OPERATIONS ---
fof(op_1, axiom, product(n_4, n_20, n_80)).
fof(op_2, axiom, product(n_2, n_80, n_160)).
fof(op_3, axiom, sum(n_20, n_80, n_160, n_260)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,N,M,P] : ((times_as_many(X, Y, N) & sheep(Y, M) & product(N, M, P)) => sheep(X, P))).
fof(rule_2, axiom, ! [X,Y,Z,A,B,C,S] : ((sheep(X, A) & sheep(Y, B) & sheep(Z, C) & sum(A, B, C, S)) => total(X, Y, Z, S))).

% --- INFERENCES ---
% From fact_2, fact_1, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, sheep(charleston, n_80)).
% From fact_3, inf_1, op_2, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, sheep(toulouse, n_160)).
% From fact_1, inf_1, inf_2, op_3, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_3, axiom, total(seattle, charleston, toulouse, n_260)).