% --- FACTS ---
fof(fact_1, axiom, planted(dan, n_3)).
fof(fact_2, axiom, roses_per_bush(dan, n_25)).
fof(fact_3, axiom, thorns_per_rose(dan, n_8)).

% --- OPERATIONS ---
fof(op_1, axiom, product(n_3, n_25, n_75)).
fof(op_2, axiom, product(n_75, n_8, n_600)).

% --- RULES ---
fof(rule_1, axiom, ! [X,N,M,P] : ((planted(X, N) & roses_per_bush(X, M) & product(N, M, P)) => total(X, P))).
fof(rule_2, axiom, ! [X,P,T,Q] : ((total(X, P) & thorns_per_rose(X, T) & product(P, T, Q)) => total(X, Q))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, total(dan, n_75)).
% From inf_1, fact_3, op_2, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, total(dan, n_600)).