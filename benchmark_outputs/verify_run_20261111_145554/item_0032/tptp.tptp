% --- FACTS ---
fof(fact_1, axiom, guess(friend1, n_80)).
fof(fact_2, axiom, second_rule(friend2, friend1)).
fof(fact_3, axiom, third_rule(friend3, friend1)).

% --- OPERATIONS ---
fof(op_1, axiom, quotient(n_80, n_2, n_40)).
fof(op_2, axiom, sum(n_40, n_20, n_60)).
fof(op_3, axiom, product(n_0_25, n_80, n_20)).
fof(op_4, axiom, sum(n_80, n_20, n_100)).
fof(op_5, axiom, sum(n_80, n_60, n_100, n_240)).
fof(op_6, axiom, quotient(n_240, n_3, n_80)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,N,H,R] : ((second_rule(X,Y) & guess(Y,N) & quotient(N, n_2, H) & sum(H, n_20, R)) => guess(X,R))).
fof(rule_2, axiom, ! [X,Y,N,P,R] : ((third_rule(X,Y) & guess(Y,N) & product(n_0_25, N, P) & sum(N, P, R)) => guess(X,R))).
fof(rule_3, axiom, ! [X,Y,Z,N1,N2,N3,S,AVG] : ((guess(X,N1) & guess(Y,N2) & guess(Z,N3) & sum(N1,N2,N3,S) & quotient(S, n_3, AVG)) => average_guess(X,Y,Z,AVG))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, op_2, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, guess(friend2, n_60)).
% From fact_1, fact_3, op_3, op_4, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, guess(friend3, n_100)).
% From fact_1, inf_1, inf_2, op_5, op_6, rule_3 by Universal Instantiation and Modus Ponens
fof(inf_3, axiom, average_guess(friend1, friend2, friend3, n_80)).