% OP-1: Sum(4, 2, 6)
tff(op_1, conjecture, $sum(4/1, 2/1) = 6/1).
% OP-2: Difference(12, 3, 9)
tff(op_2, conjecture, $difference(12/1, 3/1) = 9/1).
% OP-3: Quotient(6, 3, 2)
tff(op_3, conjecture, $quotient(6/1, 3/1) = 2/1).
% OP-4: Difference(12, 6, 6)
tff(op_4, conjecture, $difference(12/1, 6/1) = 6/1).
% OP-5: Quotient(6, 4, 1.5)
tff(op_5, conjecture, ($lesseq($difference($quotient(6/1, 4/1), 3/2), 1/20) & $lesseq($difference(3/2, $quotient(6/1, 4/1)), 1/20))).
% OP-6: Quotient(6, 1.5, 4)
tff(op_6, conjecture, $quotient(6/1, 3/2) = 4/1).