      "formula": "\u2200x\u2200p1\u2200p2\u2200r\u2200d\u2200f\u2200r2 (RatePerMonth(x,p1,r) \u2227 DiscountRate(p2,d) \u2227 Difference(1,d,f) \u2227 Product(r,f,r2) \u2192 RatePerMonth(x,p2,r2))",
      "verify_status": "PLAUSIBLE",
