% OP-1: Quotient(16, 2, 8)
tff(op_1, conjecture, $quotient(16/1, 2/1) = 8/1).
% OP-2: Quotient(8, 2, 4)
tff(op_2, conjecture, $quotient(8/1, 2/1) = 4/1).
% OP-3: Quotient(4, 2, 2)
tff(op_3, conjecture, $quotient(4/1, 2/1) = 2/1).
% OP-4: Sum(16, 8, 4, 2, 30)
tff(op_4, conjecture, $sum($sum($sum(16/1, 8/1), 4/1), 2/1) = 30/1).
% OP-5: Quotient(30, 4, 7.5)
tff(op_5, conjecture, ($lesseq($difference($quotient(30/1, 4/1), 15/2), 1/20) & $lesseq($difference(15/2, $quotient(30/1, 4/1)), 1/20))).