% OP-1: Product(7, 1.5, 10.5)
tff(op_1, conjecture, ($lesseq($difference($product(7/1, 3/2), 21/2), 1/20) & $lesseq($difference(21/2, $product(7/1, 3/2)), 1/20))).
% OP-2: Difference(10.5, 3, 7.5)
tff(op_2, conjecture, ($lesseq($difference($difference(21/2, 3/1), 15/2), 1/20) & $lesseq($difference(15/2, $difference(21/2, 3/1)), 1/20))).
% OP-3: Quotient(90, 7.5, 12)
tff(op_3, conjecture, $quotient(90/1, 15/2) = 12/1).