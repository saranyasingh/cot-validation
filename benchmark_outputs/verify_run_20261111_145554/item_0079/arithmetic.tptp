% OP-1: Quotient(18, 3, 6)
tff(op_1, conjecture, $quotient(18/1, 3/1) = 6/1).
% OP-2: Product(6, 2.50, 15)
tff(op_2, conjecture, $product(6/1, 5/2) = 15/1).
% OP-3: Quotient(18, 2, 9)
tff(op_3, conjecture, $quotient(18/1, 2/1) = 9/1).
% OP-4: Product(9, 1, 9)
tff(op_4, conjecture, $product(9/1, 1/1) = 9/1).
% OP-5: Difference(15, 9, 6)
tff(op_5, conjecture, $difference(15/1, 9/1) = 6/1).