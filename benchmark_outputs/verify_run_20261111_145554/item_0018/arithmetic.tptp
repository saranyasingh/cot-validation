% OP-1: Product(20, 35, 700)
tff(op_1, conjecture, $product(20/1, 35/1) = 700/1).
% OP-2: Product(30, 15, 450)
tff(op_2, conjecture, $product(30/1, 15/1) = 450/1).
% OP-3: Product(700, 50, 35000)
tff(op_3, conjecture, $product(700/1, 50/1) = 35000/1).
% OP-4: Product(450, 50, 22500)
tff(op_4, conjecture, $product(450/1, 50/1) = 22500/1).
% OP-5: Sum(35000, 22500, 57500)
tff(op_5, conjecture, $sum(35000/1, 22500/1) = 57500/1).