% --- FACTS ---
fof(fact_1, axiom, eats(cynthia, n_1)).
fof(fact_2, axiom, period(cynthia, n_60)).
fof(fact_3, axiom, carton_spec(n_15, n_4_00)).

% --- OPERATIONS ---
fof(op_1, axiom, product(n_60, n_1, n_60)).
fof(op_2, axiom, quotient(n_60, n_15, n_4)).
fof(op_3, axiom, product(n_4, n_4_00, n_16_00)).

% --- RULES ---
fof(rule_1, axiom, ! [X,N,D,T] : ((eats(X, N) & period(X, D) & product(D, N, T)) => consumes(X, T))).
fof(rule_2, axiom, ! [X,T,S,C,K,M] : ((consumes(X, T) & carton_spec(S, C) & quotient(T, S, K) & product(K, C, M)) => spends(X, M))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, consumes(cynthia, n_60)).
% From inf_1, fact_3, op_2, op_3, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, spends(cynthia, n_16_00)).