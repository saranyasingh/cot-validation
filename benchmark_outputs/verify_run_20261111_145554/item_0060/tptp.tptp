% --- FACTS ---
fof(fact_1, axiom, clusters(bush, n_6)).
fof(fact_2, axiom, per_cluster(bush, n_20)).
fof(fact_3, axiom, individual(bush, n_67)).

% --- OPERATIONS ---
fof(op_1, axiom, product(n_6, n_20, n_120)).
fof(op_2, axiom, sum(n_120, n_67, n_187)).

% --- RULES ---
fof(rule_1, axiom, ! [X,N,M,P] : ((clusters(X, N) & per_cluster(X, M) & product(N, M, P)) => total(X, P))).
fof(rule_2, axiom, ! [X,P,K,R] : ((total(X, P) & individual(X, K) & sum(P, K, R)) => total(X, R))).

% --- INFERENCES ---
% From fact_1, fact_2, op_1, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, total(bush, n_120)).
% From inf_1, fact_3, op_2, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, total(bush, n_187)).