% OP-1: Sum(15, 25, 40)
tff(op_1, conjecture, $sum(15/1, 25/1) = 40/1).
% OP-2: Product(40, 20, 800)
tff(op_2, conjecture, $product(40/1, 20/1) = 800/1).
% OP-3: Quotient(800, 3, 266.67)
tff(op_3, conjecture, ($lesseq($difference($quotient(800/1, 3/1), 26667/100), 1/200) & $lesseq($difference(26667/100, $quotient(800/1, 3/1)), 1/200))).