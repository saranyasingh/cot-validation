% --- FACTS ---
fof(fact_1, axiom, has_tickets(dave)).

fof(fact_2, axiom, used_tickets(12, toys)).

fof(fact_3, axiom, has_tickets(dave, 26)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : (has_tickets(X) => X > 0)).

fof(rule_2, axiom, ! [T] : (used_tickets(T, _) => less_than_tickets(T, has_tickets()))).

% --- INFERENCES ---
% From fact_1, rule_1 by Universal Instantiation
fof(inf_1, axiom, has_tickets(dave)).

% From fact_2, rule_2 by Universal Instantiation
fof(inf_2, axiom, less_than_tickets(12, has_tickets(dave))).

% INF-3: RemainingTickets(Dave) = InitialTickets(Dave) + RemainingTicketsAfterPurchase()
fof(inf_3, axiom, remaining_tickets(dave) = initial_tickets(dave) + remaining_tickets_after_purchase()).

% INF-4: InitialTickets(Dave) = RemainingTicketsAfterPurchase() + 12
fof(inf_4, axiom, initial_tickets(dave) = remaining_tickets_after_purchase() + 12).

% INF-5: InitialTickets(Dave) = 14 + 12 = 26
fof(inf_5, axiom, initial_tickets(dave) = 26).

% INF-6: InitialTickets(Dave) = 26
fof(inf_6, axiom, initial_tickets(dave) = 26).