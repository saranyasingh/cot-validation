% --- FACTS ---
fof(fact_1, axiom, won_at_arcade(dave)).
fof(fact_2, axiom, used_tickets(dave, 12)).
fof(fact_3, axiom, remaining_tickets(dave, 14)).

% --- RULES ---
fof(rule_1, axiom, ! [W] : (won_at_arcade(W) => won_at_arcade(dave))).
fof(rule_2, axiom, ! [U, N] : (used_tickets(U, N) => won_at_arcade(U))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, won_at_arcade(dave)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, won_at_arcade(dave)).
% From fact_3, rule_2 by Modus Ponens
fof(inf_3, axiom, won_at_arcade(dave)).
% From fact_1, rule_1 by Modus Ponens
fof(inf_4, axiom, won_at_arcade(dave)).