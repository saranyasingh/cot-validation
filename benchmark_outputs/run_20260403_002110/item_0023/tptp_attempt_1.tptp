% --- FACTS ---
fof(fact_1, axiom, died(13)).
fof(fact_2, axiom, grew(3)).

% --- RULES ---
fof(rule_1, axiom, ! [Survived, Died, Initial] : (plus(Survived, Died) = Initial)).

% --- INFERENCES ---
% From FACT-2, RULE-1 by Modus Ponens
fof(inf_1, axiom, survived = 3 - 13).
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_2, axiom, died > survived).
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_3, axiom, died = survived + 13).