% --- FACTS ---
fof(fact_1, axiom, baseball_cards(nell, 309) & ace_cards(nell, 356)).

% --- RULES ---
fof(rule_1, axiom, ! [N, T] : (received_cards(N, T) => total_cards(N, plus(T, received_cards)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, baseball_cards(nell, 309) & ace_cards(nell, 356)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, received_cards(nell, T) => total_cards(nell, plus(T, 59))).

% From fact_1, rule_1 by Modus Ponens
fof(inf_3, axiom, (baseball_cards(nell, 309) & ace_cards(nell, 356)) => (baseball_cards(nell, 309) - ace_cards(nell, 356) = 59)).