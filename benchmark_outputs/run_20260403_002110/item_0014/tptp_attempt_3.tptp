% --- FACTS ---
fof(fact_1, axiom, books(jerry) = 7).
fof(fact_2, axiom, action_figures(jerry) = 3).
fof(fact_3, axiom, action_figures(jerry) = action_figures(jerry) + 2).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y] : ( (books(X) & action_figures(Y)) => (books(X) - action_figures(Y)) ) ).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, books(jerry) - action_figures(jerry) = 2).