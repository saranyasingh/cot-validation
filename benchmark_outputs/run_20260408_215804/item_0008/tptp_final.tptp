% --- FACTS ---
fof(fact_1, axiom, download_rate(carla, two_gb_per_min)).

fof(fact_2, axiom, downloaded_file(carla, eighty_gb)).

fof(fact_3, axiom, file_size(two_hundred_gb)).

fof(fact_4, axiom, delay_after_restart(twenty_minutes)).

% --- RULES ---
fof(rule_1, axiom, ! [D] : ( downloaded_file(carla, D) => more_than_60_minutes(D) )).

fof(rule_2, axiom, delay(twenty_minutes)).

% --- INFERENCES ---
% From fact_2
fof(inf_1, axiom, downloaded_file(carla, eighty_gb)).

% From fact_2, fact_3 by arithmetic
fof(inf_2, axiom, less_than_120_gb_left(one_hundred_twenty_gb)).

% From rule_1, inf_1, inf_2 by Modus Ponens
fof(inf_3, axiom, more_than_60_minutes(less_than_120_gb_left(one_hundred_twenty_gb))).

% From rule_2, inf_1, inf_2, inf_3 by Modus Ponens
fof(inf_4, axiom, total_time(eighty_minutes)).

% From rule_2, inf_4 by Modus Ponens
fof(inf_5, axiom, delay(total_time(eighty_minutes))).