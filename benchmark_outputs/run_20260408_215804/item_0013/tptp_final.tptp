% --- FACTS ---
fof(fact_1, axiom, initial_investment(lemon_tree) = 90).

fof(fact_2, axiom, earnings_per_lemon(lemon_tree) = 10.5).

fof(fact_3, axiom, annual_expenses(lemon_tree) = 3).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (div(total_cost, net_profit) = years_until_start_earning)).

