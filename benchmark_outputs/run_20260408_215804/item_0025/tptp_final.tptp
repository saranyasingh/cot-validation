% --- FACTS ---
fof(fact_1, axiom, BoughtFor(19.50, Discount(25), Book(PurchasedBy(kyle)))). 

% --- RULES ---
fof(rule_1, axiom, ! [OriginalPrice, DiscountRate] : ( FinalPrice(FinalPrice(OriginalPrice, DiscountRate)) = OriginalPrice * (1 - DiscountRate) )). 

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, OriginalPrice(BoughtFor(19.50, Discount(25), Book(PurchasedBy(kyle)))) = 26).