% --- FACTS ---
fof(fact_1, axiom, ! [X] : (bolt_blue(X) <=> X = 2)).

fof(fact_2, axiom, ! [X] : (bolt_white(X) <=> X = 1)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ((bolt_blue(X) & bolt_white(X)) => total_bolts(X) = 3)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, bolt_blue(2)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, bolt_white(1)).

% From fact_1, fact_2, rule_1 by Modus Ponens
fof(inf_3, axiom, total_bolts(3) = 3).