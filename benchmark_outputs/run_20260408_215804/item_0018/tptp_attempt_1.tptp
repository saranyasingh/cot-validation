% --- RULES ---
fof(rule_1, axiom, ! [HW, HR] : (earnings_from_teaching(HW, HR) <=> (HW * HR))).
fof(rule_2, axiom, ! [HW, HR] : (earnings_from_coaching(HW, HR) <=> (HW * HR))).
fof(rule_3, axiom, ! [HT, TR, HC, CR] : (total_annual_salary(HT, TR, HC, CR) <=> (earnings_from_teaching(HT, TR) + earnings_from_coaching(HC, CR)))).

