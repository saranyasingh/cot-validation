% --- FACTS ---
fof(fact_1, axiom, total_oranges = 72).

fof(fact_2, axiom, capacity_per_bag = 8).

% --- RULES ---
fof(rule_1, axiom, ! [TotalOranges, CapacityPerBag, NumberOfBags] : ( number_of_bags_needed(TotalOranges, CapacityPerBag) => NumberOfBags = TotalOranges / CapacityPerBag )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, NumberOfBags = 9).