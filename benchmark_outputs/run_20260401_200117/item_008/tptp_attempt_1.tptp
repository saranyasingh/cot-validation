% --- FACTS ---
fof(fact_1, axiom, total_students = 32).

fof(fact_2, axiom, members_per_group = 4).

% --- RULES ---
fof(rule_1, axiom, ! [S] : ( total_students(S) => ! [M] : ( members_per_group(M) => ? [G] : ( number_of_groups(G) & divides(S, G) ) ) ) ).

fof(rule_2, axiom, ! [X, Y] : ( divides(X, Y) <=> ((X / Y) * Y = X) ) ).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, divide(32, 4) = number_of_groups).