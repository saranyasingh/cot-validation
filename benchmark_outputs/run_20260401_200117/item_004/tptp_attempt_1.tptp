% --- FACTS ---
fof(fact_1, axiom, buses(5)).
fof(fact_2, axiom, ! [B] : (buses(B) => (students_carried(B) = 30))).
fof(fact_3, axiom, vans(3)).
fof(fact_4, axiom, ! [V] : (vans(V) => (students_carried(V) = 12))).

% --- RULES ---

% --- INFERENCES ---
% From fact_1, fact_2, and fact_4 by Addition
fof(inf_1, axiom, ! [S] : (total_students(S) = students_carried(buses(S)) + students_carried(vans(S)))).
% From fact_1, fact_2, and fact_4 by Substitution
% From substitution of the numbers: TotalStudents = 186
fof(inf_2, axiom, total_students = 186).