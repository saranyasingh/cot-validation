% OP-1: Sum(1, 0.025, 1.025)
tff(op_1, conjecture, ($lesseq($difference($sum(1/1, 1/40), 41/40), 1/2000) & $lesseq($difference(41/40, $sum(1/1, 1/40)), 1/2000))).
% OP-2: Product(5000, 1.025, 5125)
tff(op_2, conjecture, $product(5000/1, 41/40) = 5125/1).
% OP-3: Sum(1, 0.012, 1.012)
tff(op_3, conjecture, ($lesseq($difference($sum(1/1, 3/250), 253/250), 1/2000) & $lesseq($difference(253/250, $sum(1/1, 3/250)), 1/2000))).
% OP-4: Product(8000, 1.012, 8096)
tff(op_4, conjecture, $product(8000/1, 253/250) = 8096/1).