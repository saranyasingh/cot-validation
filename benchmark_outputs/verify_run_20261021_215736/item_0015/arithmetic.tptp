% OP-1: Product(0.2, 20, 4)
tff(op_1, conjecture, $product(1/5, 20/1) = 4/1).
% OP-2: Difference(20, 4, 16)
tff(op_2, conjecture, $difference(20/1, 4/1) = 16/1).
% OP-3: Product(0.25, 16, 4)
tff(op_3, conjecture, $product(1/4, 16/1) = 4/1).
% OP-4: Difference(16, 4, 12)
tff(op_4, conjecture, $difference(16/1, 4/1) = 12/1).
% OP-5: Quotient(12, 20, 0.6)
tff(op_5, conjecture, ($lesseq($difference($quotient(12/1, 20/1), 3/5), 1/20) & $lesseq($difference(3/5, $quotient(12/1, 20/1)), 1/20))).
% OP-6: Product(0.6, 100, 60)
tff(op_6, conjecture, $product(3/5, 100/1) = 60/1).