% OP-1: Product(7, 1.5, 10.5)
tff(op_1, conjecture, ($lesseq($difference($product(7/1, 3/2), 21/2), 1/20) & $lesseq($difference(21/2, $product(7/1, 3/2)), 1/20))).
% OP-2: Quotient(90, 10.5, 8.57)
tff(op_2, conjecture, ($lesseq($difference($quotient(90/1, 21/2), 857/100), 1/200) & $lesseq($difference(857/100, $quotient(90/1, 21/2)), 1/200))).