% OP-1: Product(3, 1, 3)
tff(op_1, conjecture, $product(3/1, 1/1) = 3/1).
% OP-2: Product(2, 2, 4)
tff(op_2, conjecture, $product(2/1, 2/1) = 4/1).
% OP-3: Product(3, 0, 0)
tff(op_3, conjecture, $product(3/1, 0/1) = 0/1).
% OP-4: Sum(3, 4, 0, 7)
tff(op_4, conjecture, $sum($sum(3/1, 4/1), 0/1) = 7/1).