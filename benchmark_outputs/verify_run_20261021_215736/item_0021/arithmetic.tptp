% OP-1: Product(0.6667, 10, 6.6667)
tff(op_1, conjecture, ($lesseq($difference($product(6667/10000, 10/1), 66667/10000), 1/20000) & $lesseq($difference(66667/10000, $product(6667/10000, 10/1)), 1/20000))).
% OP-2: Product(0.6, 15, 9)
tff(op_2, conjecture, $product(3/5, 15/1) = 9/1).
% OP-3: Sum(10, 15, 25)
tff(op_3, conjecture, $sum(10/1, 15/1) = 25/1).
% OP-4: Difference(25, 1, 24)
tff(op_4, conjecture, $difference(25/1, 1/1) = 24/1).
% OP-5: Product(9, 3, 27)
tff(op_5, conjecture, $product(9/1, 3/1) = 27/1).
% OP-6: Product(24, 3, 72)
tff(op_6, conjecture, $product(24/1, 3/1) = 72/1).
% OP-7: Product(3, 1, 3)
tff(op_7, conjecture, $product(3/1, 1/1) = 3/1).
% OP-8: Difference(27, 3, 24)
tff(op_8, conjecture, $difference(27/1, 3/1) = 24/1).
% OP-9: Difference(72, 24, 48)
tff(op_9, conjecture, $difference(72/1, 24/1) = 48/1).
% OP-10: Quotient(48, 3, 16)
tff(op_10, conjecture, $quotient(48/1, 3/1) = 16/1).
% OP-11: Product(0.6667, 16, 10.6667)
tff(op_11, conjecture, ($lesseq($difference($product(6667/10000, 16/1), 106667/10000), 1/20000) & $lesseq($difference(106667/10000, $product(6667/10000, 16/1)), 1/20000))).
% OP-12: Sum(10.6667, 9, 19.6667)
tff(op_12, conjecture, ($lesseq($difference($sum(106667/10000, 9/1), 196667/10000), 1/20000) & $lesseq($difference(196667/10000, $sum(106667/10000, 9/1)), 1/20000))).