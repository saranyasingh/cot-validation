% --- FACTS ---
fof(fact_1, axiom, combined_weight(marco, dad, 30)).

fof(fact_2, axiom, dad_weight(dad, 11)).

fof(fact_3, axiom, subtract(30, 11, 19)).

% --- RULES ---
fof(rule_1, axiom, ! [M, D, W, WD, WM] : ((combined_weight(M, D, W) & dad_weight(D, WD) & subtract(W, WD, WM)) => marco_weight(M, WM))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_3, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, marco_weight(marco, 19)).