{"seq": 64, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "C11", "value": {"shape": "fact", "text": "2x/3 - 2 = 10", "cot_quote": "first multiply both sides by 2", "content": {"relation": "value_equals", "args": ["2*x/3 - 2", 10], "negated": false}, "kind": null, "stated_in_cot": true, "id": "C11", "label": "derived", "english": "[unknown relation None]."}}
{"seq": 65, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "C12", "value": {"shape": "fact", "text": "2x/3 = 12", "cot_quote": "Then add 2 to both sides", "content": {"relation": "value_equals", "args": ["2*x/3", 12], "negated": false}, "kind": null, "stated_in_cot": true, "id": "C12", "label": "derived", "english": "[unknown relation None]."}}
