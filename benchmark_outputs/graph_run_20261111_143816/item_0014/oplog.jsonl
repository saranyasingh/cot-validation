{"seq": 67, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "I1", "value": {"shape": "rule", "text": "The number of items remaining after a sale equals the number before the sale minus the number sold.", "kind": "math_principle", "stated_in_cot": false, "cot_quote": null, "content": {"vars": {"p": "person", "h1": "house", "h2": "house", "a": "num", "n": "num", "r": "num"}, "if": [{"relation": "left_after", "args": ["p", "h1", "a"]}, {"relation": "sold_count", "args": ["p", "h2", "n"]}], "calc": [{"op": "difference", "args": ["a", "n"], "result": "r"}], "then": [{"relation": "left_after", "args": ["p", "h2", "r"]}], "form": "implies"}, "id": "I1", "label": "assumption", "english": "Either ."}}
{"seq": 68, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "I2", "value": {"shape": "fact", "text": "'A third of her vacuum cleaners' means x/3, one third of her starting total x.", "kind": "definitional", "stated_in_cot": false, "cot_quote": null, "content": {"relation": "sold_count", "args": ["melanie", "green_house", "x/3"], "negated": false}, "id": "I2", "label": "assumption", "english": "[unknown relation None]."}}
{"seq": 69, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "I3", "value": {"shape": "rule", "text": "Half of a quantity q is (1/2)q.", "kind": "definitional", "stated_in_cot": false, "cot_quote": null, "content": {"vars": {"p": "person", "h1": "house", "h2": "house", "q": "num", "f": "num", "r": "num"}, "if": [{"relation": "left_after", "args": ["p", "h1", "q"]}, {"relation": "sold_fraction", "args": ["p", "h2", "f"]}], "calc": [{"op": "product", "args": ["f", "q"], "result": "r"}], "then": [{"relation": "sold_count", "args": ["p", "h2", "r"]}], "form": "implies"}, "id": "I3", "label": "assumption", "english": "Either ."}}
{"seq": 70, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "I4", "value": {"shape": "closure", "text": "The green, red, and orange house sales are all of her sales, and the orange house sale is the last one, so the 5 left is the amount remaining after the orange house.", "kind": "closure", "stated_in_cot": false, "cot_quote": null, "content": {"whole": "melanie", "relation": "house_sale", "members": ["green_house", "red_house", "orange_house"]}, "id": "I4", "label": "assumption", "english": "[could not render: list index out of range]"}}
{"seq": 71, "time": "2026-11-11T14:50:02", "agent": "encoder", "op": "put", "collection": "statements", "id": "I5", "value": {"shape": "rule", "text": "Applying the same operation (adding or multiplying by the same nonzero number) to both sides of an equation preserves equality.", "kind": "math_principle", "stated_in_cot": false, "cot_quote": null, "content": {"vars": {"a": "num", "b": "num", "k": "num", "c": "num", "d": "num", "e": "num", "f": "num"}, "if": [{"relation": "value_equals", "args": ["a", "b"]}], "calc": [{"op": "sum", "args": ["a", "k"], "result": "c"}, {"op": "sum", "args": ["b", "k"], "result": "d"}, {"op": "product", "args": ["a", "k"], "result": "e"}, {"op": "product", "args": ["b", "k"], "result": "f"}], "then": [{"relation": "value_equals", "args": ["c", "d"]}, {"relation": "value_equals", "args": ["e", "f"]}], "form": "implies"}, "id": "I5", "label": "assumption", "english": "Either ."}}
