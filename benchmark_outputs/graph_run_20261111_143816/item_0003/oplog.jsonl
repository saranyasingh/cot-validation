{"seq": 60, "time": "2026-11-11T14:40:34", "agent": "encoder", "op": "put", "collection": "statements", "id": "I3", "value": {"shape": "rule", "text": "Taking a percentage of a quantity means multiplying the quantity by that percentage expressed as a decimal.", "kind": "math_principle", "stated_in_cot": false, "cot_quote": null, "content": {"vars": {"h": "property", "p": "num", "v": "num", "d": "num", "c": "num"}, "if": [{"relation": "increase_pct_of_original", "args": ["h", "p", "v"]}, {"relation": "pct_decimal", "args": ["p", "d"]}], "calc": [{"op": "product", "args": ["d", "v"], "result": "c"}], "then": [{"relation": "value_increase", "args": ["h", "c"]}], "form": "implies"}, "id": "I3", "label": "assumption", "english": "Either ."}}
{"seq": 61, "time": "2026-11-11T14:40:34", "agent": "encoder", "op": "put", "collection": "statements", "id": "I4", "value": {"shape": "fact", "text": "150% expressed as a decimal is 1.5.", "kind": "math_principle", "stated_in_cot": false, "cot_quote": null, "content": {"relation": "pct_decimal", "args": [150, 1.5], "negated": false}, "id": "I4", "label": "assumption", "english": "[unknown relation None]."}}
{"seq": 62, "time": "2026-11-11T14:40:34", "agent": "encoder", "op": "put", "collection": "statements", "id": "I5", "value": {"shape": "fact", "text": "Josh's return from the house is its new value after repairs (he sells it at that value).", "kind": "stipulative", "stated_in_cot": false, "cot_quote": null, "content": {"relation": "return_is_new_value", "args": ["josh", "house"], "negated": false}, "id": "I5", "label": "assumption", "english": "[unknown relation None]."}}
