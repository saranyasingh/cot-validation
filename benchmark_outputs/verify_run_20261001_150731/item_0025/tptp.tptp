% --- FACTS ---
fof(fact_1, axiom, paid_amount(kyle, 19.50)).
fof(fact_2, axiom, discount_percent(kyle, 25)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : (discount_percent(X,25) => paid_fraction(X,0.75))).
fof(rule_2, axiom, ! [X,Y,F] : ((paid_amount(X,Y) & paid_fraction(X,F)) => original_price(X, Y/F))).

% --- INFERENCES ---
% From fact_2, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, paid_fraction(kyle, 0.75)).
% From fact_1, inf_1, rule_2 by Universal Instantiation and Modus Ponens
fof(inf_2, axiom, original_price(kyle, 26)).