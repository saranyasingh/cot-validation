% --- FACTS ---
fof(fact_1, axiom, house_uses_blocks(house, blocks_20)).
fof(fact_2, axiom, tower_uses_blocks(tower, blocks_50)).
fof(fact_3, axiom, difference(blocks_50, blocks_20, blocks_30)).

% --- RULES ---
fof(rule_1, axiom, ! [H, T, B20, B50, B30] : ((house_uses_blocks(H, B20) & tower_uses_blocks(T, B50) & difference(B50, B20, B30)) => more_blocks_than(T, H, B30))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_3, rule_1 by Modus Ponens
fof(inf_1, axiom, more_blocks_than(tower, house, blocks_30)).