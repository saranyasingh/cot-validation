% --- FACTS ---
fof(fact_1, axiom, total_cost_two_books(edward, c_6)).
fof(fact_2, axiom, books_bought(edward, c_2)).
fof(fact_3, axiom, money_left(edward, c_12)).
fof(fact_4, axiom, equal_cost_per_book_for_two(edward)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : (( total_cost_two_books(X, c_6) & books_bought(X, c_2) & equal_cost_per_book_for_two(X)) => price_per_book(X, c_3))).

% --- INFERENCES ---
% From FACT-1, FACT-2, FACT-4, RULE-1 by Modus Ponens
fof(inf_1, axiom, price_per_book(edward, c_3)).