% --- FACTS ---
fof(fact_1, axiom, book_has_chapters(book, three)).
fof(fact_2, axiom, all_chapters_have_same_pages(book)).
fof(fact_3, axiom, total_pages(book, five_hundred_ninety_four)).

% --- RULES ---
fof(rule_1, axiom, ! [B] : ((book_has_chapters(B, three) & all_chapters_have_same_pages(B)) => ? [P] : (pages_per_chapter(B, P) & total_pages_equals_three_times(B, P)))).
fof(rule_2, axiom, ! [B] : ! [P] : ((total_pages_equals_three_times(B, P) & total_pages(B, five_hundred_ninety_four)) => P = one_hundred_ninety_eight)).

% --- INFERENCES ---
% From FACT-1, FACT-2, RULE-1 by Modus Ponens
fof(inf_1, axiom, ? [P] : (pages_per_chapter(book, P) & total_pages_equals_three_times(book, P))).

% From inf_1, FACT-3, RULE-2 by Modus Ponens
fof(inf_2, axiom, pages_per_chapter(book, one_hundred_ninety_eight)).