% --- FACTS ---
fof(fact_1, axiom, lost(int_412)).
fof(fact_2, axiom, given_to_friends(int_90)).
fof(fact_3, axiom, initial_crayons(int_110)).
fof(fact_4, axiom, answer(int_322)).

% --- RULES ---
fof(rule_1, axiom, ! [L:$int] : ! [G:$int] : ((lost(L) & given_to_friends(G)) => ? [D:$int] : subtract(L, G, D))).
fof(rule_2, axiom, ! [L:$int] : ! [G:$int] : (((lost(L) & given_to_friends(G)) & L = int_412 & G = int_90) => subtract(L, G, int_322))).
fof(rule_3, axiom, ! [L:$int] : ! [G:$int] : ! [D:$int] : (subtract(L, G, D) => difference_is(L, G, D))).
fof(rule_4, axiom, ! [L:$int] : ! [G:$int] : ! [D:$int] : (difference_is(L, G, D) => answer(D))).
fof(rule_5, axiom, ! [I:$int] : ! [L:$int] : ! [G:$int] : ! [D:$int] : ((initial_crayons(I) & lost(L) & given_to_friends(G) & subtract(L, G, D)) => answer(D))).

% --- INFERENCES ---
% From fact_1, fact_2 by Modus Ponens on rule_2
fof(inf_1, axiom, subtract(int_412, int_90, int_322)).
% From inf_1 by Modus Ponens on rule_3
fof(inf_2, axiom, difference_is(int_412, int_90, int_322)).
% From inf_2 by Modus Ponens on rule_4
fof(inf_3, axiom, answer(int_322)).
% From fact_3, inf_1 by Modus Ponens on rule_5
fof(inf_4, axiom, answer(int_322)).