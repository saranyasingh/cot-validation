% --- FACTS ---
fof(fact_1, axiom, lost(412)).
fof(fact_2, axiom, given_to_friends(90)).
fof(fact_3, axiom, initial_crayons(110)).
fof(fact_4, axiom, answer(322)).

% --- RULES ---
fof(rule_1, axiom, ! [L,G] : ((lost(L) & given_to_friends(G)) => ? [D] : subtract(L, G, D))).
fof(rule_2, axiom, ! [L,G] : ((lost(L) & given_to_friends(G) & L = 412 & G = 90) => subtract(L, G, 322))).
fof(rule_3, axiom, ! [L,G,D] : (subtract(L, G, D) => difference_is(L, G, D))).
fof(rule_4, axiom, ! [L,G,D] : (difference_is(L, G, D) => answer(D))).
fof(rule_5, axiom, ! [I,L,G,D] : ((initial_crayons(I) & lost(L) & given_to_friends(G) & subtract(L, G, D)) => answer(D))).

% --- INFERENCES ---
% From fact_1, fact_2 by Modus Ponens
fof(inf_1, axiom, subtract(412, 90, 322)).
% From inf_1, rule_3 by Modus Ponens
fof(inf_2, axiom, difference_is(412, 90, 322)).
% From inf_2, rule_4 by Modus Ponens
fof(inf_3, axiom, answer(322)).
% From fact_3, inf_1, rule_5 by Modus Ponens
fof(inf_4, axiom, answer(322)).