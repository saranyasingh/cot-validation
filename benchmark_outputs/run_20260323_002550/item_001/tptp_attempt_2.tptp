% --- FACTS ---
fof(fact_1, axiom, total(oranges, 87)).
fof(fact_2, axiom, groups(oranges, 93)).
fof(fact_3, axiom, total(bananas, 290)).
fof(fact_4, axiom, groups(bananas, 2)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ( ! [T] : ( ! [G] : (( total(X, T) & groups(X, G)) => group_size(X, $quotient(T, G)) ) ) )).

% --- INFERENCES ---
% From fact_3, fact_4, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, group_size(bananas, $quotient(290, 2))).

% From inf_1 by Arithmetic
fof(inf_2, axiom, group_size(bananas, 145)).