% --- FACTS ---
fof(fact_1, axiom, weight(dads_strawberries, 11)).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y, W, T] : ((weight(X, W) & total_weight(X, Y, T)) => weight(Y, $difference(T, W)))).

% --- INFERENCES ---
% From fact_1, fact_2, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, weight(marco_strawberries, $difference(30, 11))).