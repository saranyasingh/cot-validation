% --- FACTS ---
fof(fact_1, axiom, weight(dads_strawberries, 11)).

fof(fact_2, axiom, total_weight(marco_strawberries, dads_strawberries, 30)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ! [Y] : ! [W] : ! [T] : ((weight(X, W) & total_weight(X, Y, T)) => weight(Y, $difference(T, W))).

% --- INFERENCES ---
% From FACT-1, FACT-2, RULE-1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, weight(marco_strawberries, 19)).