% --- FACTS ---
fof(fact_1, axiom, total_pages(594)).
fof(fact_2, axiom, number_of_chapters(3)).
fof(fact_3, axiom, same_page_count_per_chapter).

% --- RULES ---
fof(rule_1, axiom, ! [P] : ! [C] : ((total_pages(P) & number_of_chapters(C) & same_page_count_per_chapter) => pages_per_chapter(P ÷ C))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_3, rule_1 by Universal Instantiation and Modus Ponens
fof(inf_1, axiom, pages_per_chapter(594 ÷ 3)).
% From inf_1 by Arithmetic
fof(inf_2, axiom, pages_per_chapter(198)).