% --- RULES ---
fof(rule_1, axiom, ! [X] : ! [H] : ! [R] : ! [E] : ((regular_hours(X,H) & regular_rate(X,R) & multiplies(H,R,E)) => regular_earnings(X,E))).
fof(rule_2, axiom, ! [X] : ! [H] : ! [R] : ! [E] : ((overtime_hours(X,H) & overtime_rate(X,R) & multiplies(H,R,E)) => overtime_earnings(X,E))).
fof(rule_3, axiom, ! [X] : ! [A] : ! [B] : ! [C] : ((regular_earnings(X,A) & overtime_earnings(X,B) & sum(A,B,C)) => total_earnings(X,C))).

% --- INFERENCES ---
