% --- FACTS ---
fof(fact_1, axiom, blue_fiber_count(blue, 2)).
fof(fact_2, axiom, white_fiber_count(blue) = div(blue_fiber_count(blue), 2)).

% --- RULES ---
fof(rule_1, axiom, ! [C] : (total_bolts(C) = plus(blue_fiber_count(C), white_fiber_count(C)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_bolts(blue) = plus(blue_fiber_count(blue), white_fiber_count(blue))).