% --- FACTS ---
fof(fact_1, axiom, initial_investment(90)).

% --- RULES ---
fof(rule_1, axiom, ! [N, P, C] : (annual_profit(N, P, C) = N * P - C)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, annual_revenue = 7 * 1.5 - 3).
% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, n = Ceiling(InitialInvestment / AnnualRevenue)).
% From fact_1, rule_1 by Modus Ponens
fof(inf_3, axiom, n = 13).