% --- FACTS ---
fof(fact_1, axiom, morning_feed(15)).
fof(fact_2, axiom, afternoon_feed(25)).

% --- RULES ---
fof(rule_1, axiom, ! [Avg, X, Y] : (Avg = morning_feed(X) + (afternoon_feed(Y) / 20))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [Final, Avg, X, Y] : (Final = average_feed_per_chicken(Avg) = (morning_feed(X) + afternoon_feed(Y)) / 20)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, ! [CorrectAnswer, Final] : ( (CorrectAnswer = Final) & (Final = 2) )).