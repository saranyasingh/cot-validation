% --- FACTS ---
fof(fact_1, axiom, download_rate(2)).  
fof(fact_2, axiom, download_speed(2)).  
fof(fact_3, axiom, data_size(200)).  

% --- RULES ---
fof(rule_1, axiom, ! [X, Y, T] : ( downloaded_at(2, T) => downloaded(X, Y) )).  

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, downloaded_at(2, t_before_restart)).  
% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, downloaded_at(2, t_after_restart)).  
% From fact_3, rule_1 by Modus Ponens
fof(inf_3, axiom, duration_of_download(80, t_before_restart)).  
% From fact_3, rule_1 by Modus Ponens
fof(inf_4, axiom, duration_of_download(120, t_after_restart)).  
% From fact_3, rule_1 by Modus Ponens
fof(inf_5, axiom, total_time(200) = duration_of_download(80, t_before_restart) + duration_of_download(120, t_after_restart)).