% --- RULES ---
fof(rule_1, axiom, ! [P2, P1, M, V2, V1] : ((total_value_after(P2, M, V2) & total_value_after(P1, M, V1) & greater_than(V2, V1)) => higher_value_between_plans(P2, P1, M))).

% --- INFERENCES ---
% From FACT-6, FACT-3, FACT-7 by RULE-1
fof(inf_1, axiom, higher_value_between_plans(electronics, jewelry, month_one)).
