% --- FACTS ---
fof(fact_1, axiom, daily_feed_per_chicken(three_cups)).
fof(fact_2, axiom, morning_feed_amount(fifteen_cups)).
fof(fact_3, axiom, afternoon_feed_amount(twentyfive_cups)).
fof(fact_4, axiom, chickens_count(twenty)).

% --- RULES ---
fof(rule_1, axiom, ! [T, C, R] : ((divide(T, C, R)) => (per_chicken_final_meal(R)))).

% --- INFERENCES ---
% From fact_2, fact_3 by Arithmetic Computation
fof(inf_1, axiom, add(fifteen_cups, twentyfive_cups, forty_cups)).
% From inf_1, fact_4 by Arithmetic Computation
fof(inf_2, axiom, divide(forty_cups, twenty, two_cups)).
% From inf_2, rule_1 by Modus Ponens
fof(inf_3, axiom, per_chicken_final_meal(two_cups)).