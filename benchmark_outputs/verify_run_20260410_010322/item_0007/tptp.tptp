% --- FACTS ---
fof(fact_1, axiom, sheep_count(seattle, n_20)).
fof(fact_2, axiom, times_as_many(charleston, seattle, n_4)).
fof(fact_3, axiom, times_as_many(toulouse, charleston, n_2)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,N,M,Z] : ((times_as_many(X,Y,N) & sheep_count(Y,M) & product(N,M,Z)) => sheep_count(X,Z))).

% --- INFERENCES ---
% From fact_2, fact_1 by Arithmetic Computation
fof(inf_1, axiom, product(n_4, n_20, n_80)).
% From fact_2, fact_1, inf_1 by RULE-1
fof(inf_2, axiom, sheep_count(charleston, n_80)).
% From fact_3, inf_2 by Arithmetic Computation
fof(inf_3, axiom, product(n_2, n_80, n_160)).
% From fact_3, inf_2, inf_3 by RULE-1
fof(inf_4, axiom, sheep_count(toulouse, n_160)).
% From fact_1, inf_2 by Arithmetic Computation
fof(inf_5, axiom, sum(n_20, n_80, n_100)).
% From inf_5, inf_3 by Arithmetic Computation
fof(inf_6, axiom, sum(n_100, n_160, n_260)).
% From inf_6 by Arithmetic Computation
fof(inf_7, axiom, total_sheep(n_260)).