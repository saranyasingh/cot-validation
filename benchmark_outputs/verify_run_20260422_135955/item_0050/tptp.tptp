% --- FACTS ---
fof(fact_1, axiom, floors_in_building(n_15)).
fof(fact_2, axiom, units_per_floor(n_8)).
fof(fact_3, axiom, occupied_fraction(n_3_over_4)).

% --- RULES ---
fof(rule_1, axiom, ! [F,U,T] : (product(F,U,T) => total_units(T))).

% --- INFERENCES ---
% From fact_1, fact_2 by Arithmetic Computation
fof(inf_1, axiom, product(n_15, n_8, n_120)).
% From inf_1, rule_1 by Modus Ponens
fof(inf_2, axiom, total_units(n_120)).
% From inf_2, fact_3 by Arithmetic Computation
fof(inf_3, axiom, occupied_units(n_90)).
% From inf_2, inf_3 by Arithmetic Computation
fof(inf_4, axiom, unoccupied_units(n_30)).