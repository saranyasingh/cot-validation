% --- FACTS ---
fof(fact_1, axiom, yogurts_per_day(terry, n_2)).

fof(fact_2, axiom, yogurts_needed(terry, n_60)).

fof(fact_3, axiom, pack_size(yogurt, n_4)).

fof(fact_4, axiom, price_per_pack(yogurt, n_5)).

% --- RULES ---
fof(rule_1, axiom, ! [T] : ((yogurts_needed(T, n_60) & pack_size(yogurt, n_4)) => packs_needed(T, n_15))).

fof(rule_2, axiom, ! [T] : ((packs_needed(T, n_15) & price_per_pack(yogurt, n_5)) => total_cost(T, n_75))).

% --- INFERENCES ---
% From fact_2, fact_3 by Modus Ponens
fof(inf_1, axiom, packs_needed(terry, n_15)).

% From inf_1, fact_4 by Modus Ponens
fof(inf_2, axiom, total_cost(terry, n_75)).