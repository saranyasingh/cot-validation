% --- FACTS ---
fof(fact_1, axiom, r(5)).
fof(fact_2, axiom, y(14)).
fof(fact_3, axiom, g(6)).

% --- RULES ---
fof(rule_1, axiom, ! [R, Y, G] : ( sum(R, Y, G) = t(total_peaches) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Substitution
fof(inf_1, axiom, sum(r(5), y(14), g(6)) = t(total_peaches)).
% From fact_1, rule_1 by Substitution
fof(inf_2, axiom, sum(r(5), y(14), g(6)) = t(19)).
% From inf_2 by Substitution
fof(inf_3, axiom, g(6) = sub(t(19), sum(r(5), y(14)))).
% From inf_3 by Substitution
fof(inf_4, axiom, g(5)).