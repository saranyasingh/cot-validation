% --- FACTS ---
fof(fact_1, axiom, played(t_2_rounds)).
fof(fact_2, axiom, scored(84, t_2_rounds)).

% --- RULES ---
fof(rule_1, axiom, ! [TotalPoints, Rounds] : (average_score(TotalPoints, Rounds) = TotalPoints / Rounds)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, points_per_round(total_points, rounds) = total_points / rounds).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, points_per_round(84, 2) = 84 / 2).

% From inf_2 by Simplification
fof(inf_3, axiom, points_per_round(84, 2) = 84 / 2).

% From inf_3 by Arithmetic simplification
fof(inf_4, axiom, 84 / 2 = 42).

% From inf_4 by Substitution
fof(inf_5, axiom, points_per_round(84, 2) = 42).