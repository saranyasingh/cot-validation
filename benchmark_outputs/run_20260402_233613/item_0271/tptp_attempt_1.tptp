% --- FACTS ---
fof(fact_1, axiom, ! [H] : (house(H) => junk_mail(H, 4))).
fof(fact_2, axiom, ! [B] : (block(B) => length_of_block(B, 12))).

% --- RULES ---
fof(rule_1, axiom, ! [H] : (junk_mail(H, 4))).
fof(rule_2, axiom, ! [B] : (block(B) => length_of_block(B, 12))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [H,B] : ((house(H) & block(B)) => junk_mail(H, 4))).
% From fact_2, rule_2 by Universal Instantiation
fof(inf_2, axiom, ! [B] : (block(B) => length_of_block(B, 12))).
% Total junk mail distribution across all blocks
% From fact_1, rule_1 by a derived inference
fof(inf_3, axiom, ! [B] : (block(B) => total_junk_in_block(B))).
% Number of blocks
fof(inf_4, axiom, ! [B] : (block(B))).
% Total junk mail per block
fof(inf_5, axiom, ! [B] : (block(B) => total_junk_in_block_per_block(B))).