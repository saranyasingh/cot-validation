% --- FACTS ---
fof(fact_1, axiom, chocolate_chip_cookies_baked_yesterday(yesterday) = 19).
fof(fact_2, axiom, raisin_cookies_baked_today(today) = 231).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y, Z] : ((X + Y = Z) => (X + Y = Z))).
fof(rule_2, axiom, ! [X, Y, Z] : ((X - Y = Z) => (X - Y = Z))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, chocolate_chip_cookies_baked_yesterday(yesterday) + chocolate_chip_cookies_baked_today = 256).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, raisin_cookies_baked(today) = 231).
% From fact_1, rule_1 by Modus Ponens
fof(inf_3, axiom, total_chocolate_chip_cookies_today - total_raisin_cookies_today = 25).