% --- FACTS ---
fof(fact_1, axiom, action_figures(jerry, 8)).
fof(fact_2, axiom, books(jerry, 9)).
fof(fact_3, axiom, added_books(jerry, 10)).

% --- RULES ---
fof(rule_1, axiom, ! [BooksSet, N] : ( add_quantity(BooksSet, N) => size_of_set(BooksSet) = size_of_set(BooksSet) + N ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, action_figures(jerry, 8)).
% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, books(jerry, 9)).
% From fact_3, rule_1 by Modus Ponens
fof(inf_3, axiom, books(jerry, 19)).