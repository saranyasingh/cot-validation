% --- FACTS ---
fof(fact_1, axiom, money(dan, t_initial)).
fof(fact_2, axiom, amount(4, t_initial)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,Z] : ((money(X, t_start) & spend(Y, t_start)) => money(Z, t_end))).

% --- INFERENCES ---
