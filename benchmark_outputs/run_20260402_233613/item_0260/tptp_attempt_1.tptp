% --- FACTS ---
fof(fact_1, axiom, books_spent(edward, 16)).
fof(fact_2, axiom, pens_spent(edward, 8)).

% --- RULES ---
fof(rule_1, axiom, expenditure(edward) = books_spent(edward, 16) + pens_spent(edward, 8)).

% --- INFERENCES ---
% From fact_1, fact_2, rule_1 by Modus Ponens
fof(inf_1, axiom, expenditure(edward) = books_spent(edward, 16) + pens_spent(edward, 8)).