% --- FACTS ---
fof(fact_1, axiom, books_spent(edward, 16)).
fof(fact_2, axiom, pens_spent(edward, 8)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ( expenditure(X) = books_spent(X) + pens_spent(X) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, books_spent(edward) - pens_spent(edward) = books_spent(edward) - pens_spent(edward)).

% From fact_1, rule_1 by Algebra
fof(inf_2, axiom, expenditure(edward) - pens_spent(edward) = books_spent(edward)).

% From fact_1, rule_1 by Algebra
fof(inf_3, axiom, books_spent(edward) = expenditure(edward) - pens_spent(edward)).