% --- FACTS ---
fof(fact_1, axiom, bought(lucy, 2, cookies)).
fof(fact_2, axiom, bought(lucy, 12, cakes)).

% --- RULES ---
fof(rule_1, axiom, ! [X, Q, Item] : ( bought(X, Q, Item) => has(X, Q, Item) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Universal Instantiation
fof(inf_1, axiom, has(lucy, 2, cookies)).
% From fact_2, rule_1 by Universal Instantiation
fof(inf_2, axiom, has(lucy, 12, cakes)).
% INF-3
fof(inf_3, axiom, has(lucy, 2, cookies) & has(lucy, 12, cakes)).
% INF-4
% From the conclusion, Lucy had 56 cents left as change
fof(inf_4, axiom, change(total_spent(lucy)) = 56).
% INF-5
% Using Rule-2: InitialAmount(TotalSpent(T)) = TotalSpent(TotalSpent(T)) + 56
fof(inf_5, axiom, initial_amount(total_spent(lucy)) = total_spent(total_spent(lucy)) + 56).
% INF-6
% Let T be the initial amount of money Lucy started with
fof(inf_6, axiom, ! [T] : ( initial_amount(T) = total_spent(total_spent(T)) + 56 ) ).
% INF-7
% Since TotalSpent(TotalSpent(T)) includes all packs bought, including cookies and cakes, we can say: TotalSpent(TotalSpent(T)) = Bought(Cookies) + Bought(Cakes)
fof(inf_7, axiom, total_spent(total_spent(lucy)) = bought(cookies) + bought(cakes)).
% INF-8
% Substituting the values: TotalSpent(TotalSpent(T)) = 2 + 12 = 14 packs
fof(inf_8, axiom, total_spent(total_spent(lucy)) = 2 + 12).
% INF-9
% Therefore, InitialAmount(T) = 14 packs + 56 cents
fof(inf_9, axiom, initial_amount(lucy) = 14 + 56).
% INF-10
% The total number of packs of groceries Lucy bought is 14.
fof(inf_10, axiom, total_packs(lucy) = 14).
% INF-11
% The total number of packs of groceries Lucy bought is 14.
fof(inf_11, axiom, total_packs(lucy) = 14).