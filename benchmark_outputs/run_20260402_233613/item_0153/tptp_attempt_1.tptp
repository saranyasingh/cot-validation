% --- FACTS ---
fof(fact_1, axiom, total_flour_needed(12)).
fof(fact_2, axiom, flour_already_added(2)).
fof(fact_3, axiom, remaining_flour(total_flour_needed() - flour_already_added())).

% --- RULES ---
fof(rule_1, axiom, ! [F, S] : (flour_needed(F) & salt_required(S) => (F - S))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, remaining_flour(10)).
% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, remaining_salt(7)).
% From fact_3, rule_1 by Modus Ponens
fof(inf_3, axiom, difference(z, y)).