% --- FACTS ---
fof(fact_1, axiom, length(room)).

fof(fact_2, axiom, width(room)).

% --- RULES ---
fof(rule_1, axiom, ! [R] : (difference_between_dimensions(length(R), width(R)) = length(R) - width(R))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, difference_between_dimensions(length(room), width(room)) = 1).