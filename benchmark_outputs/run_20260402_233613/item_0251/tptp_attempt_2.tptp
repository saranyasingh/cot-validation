% --- FACTS ---
fof(fact_1, axiom, initial_number_of_cakes = 149).
fof(fact_2, axiom, number_of_cakes_sold = 10).

% --- RULES ---
fof(rule_1, axiom, remaining_cakes = initial_number_of_cakes - number_of_cakes_sold).

% --- INFERENCES ---
