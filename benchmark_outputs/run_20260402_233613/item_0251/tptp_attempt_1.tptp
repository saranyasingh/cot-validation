% --- FACTS ---
fof(fact_1, axiom, InitialNumberOfCakes = 149).

fof(fact_2, axiom, NumberOfCakesSold = 10).

% --- RULES ---
fof(rule_1, axiom, RemainingCakes = InitialNumberOfCakes - NumberOfCakesSold).

% --- INFERENCES ---
% From fact_1, fact_2, rule_1 by Rule Application
fof(inf_1, axiom, RemainingCakesAfterSale = rule_1(InitialNumberOfCakes, NumberOfCakesSold)).