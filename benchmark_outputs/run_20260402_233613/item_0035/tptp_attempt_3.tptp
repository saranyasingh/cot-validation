% --- FACTS ---
fof(fact_1, axiom, many_books_exist).

% --- RULES ---
fof(rule_1, axiom, ! [TOTAL_BOOKS, BOOKS_READ, REMAINING_BOOKS] : ( total_books(TOTAL_BOOKS, BOOKS_READ, REMAINING_BOOKS) <=> ( ! [BOOK] : ( books_exist(BOOK) => ( books_read(BOOK) & remaining_books(BOOK) ) ) ) ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_books(21, 13, 8)).