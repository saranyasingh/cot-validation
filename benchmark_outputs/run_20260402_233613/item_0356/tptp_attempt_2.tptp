% --- FACTS ---
fof(fact_1, axiom, initial_count(3)).
fof(fact_2, axiom, found_marbles(6)).
fof(fact_3, axiom, lost_marbles(5)).

% --- RULES ---
fof(rule_1, axiom, ! [W, X, Y] : ( W = initial_count(X) + found_marbles(Y) ) ).
fof(rule_2, axiom, ! [U, Y, Z] : ( U = found_marbles(Y) - lost_marbles(Z) ) ).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Addition
fof(inf_1, axiom, total_after_finding(9)).
% From FACT-2, RULE-1 by Subtraction
fof(inf_2, axiom, difference_between_found_and_lost(1)).