% --- FACTS ---
fof(fact_1, axiom, cracker_count_matthew(29) & cake_count_matthew(30)).

% --- RULES ---
fof(rule_1, axiom, ! [N] : (even(N) => div(N, 2))).

% --- INFERENCES ---
