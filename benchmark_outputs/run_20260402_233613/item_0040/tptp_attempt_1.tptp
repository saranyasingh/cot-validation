fof(inf_1, axiom, wants_to_distribute(2, cracker_count_matthew, cake_count_matthew)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, crackers_per_friend(14.5)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_3, axiom, cakes_per_friend(15)).