% --- FACTS ---
fof(fact_1, axiom, reading_rate(22, frank)).
fof(fact_2, axiom, book_completion_time(569, frank)).

% --- RULES ---
fof(rule_1, axiom, ! [Rate, Days, X] : (reading_rate(Rate, X) => book_completion_time(Days, X))).
fof(rule_2, axiom, ! [A, B, C] : ( mult(A, plus(B, C)) = plus(mult(A, B), mult(A, C)) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, book_completion_time(569, reading_rate(22, frank))).