% --- FACTS ---
fof(fact_1, axiom, baker_made(52, pastries)).
fof(fact_2, axiom, baker_made(84, cakes)).
fof(fact_3, axiom, baker_sold(102, cakes)).
fof(fact_4, axiom, baker_sold(94, pastries)).

% --- RULES ---
fof(rule_1, axiom, ! [X, Type] : (quantity_of(X, Type) => type_of(X, Type))).
fof(rule_2, axiom, ! [X, Y, Type] : (baker_sold(X, Y) <=> minus(quantity_of(X, Type), Y))).
fof(rule_3, axiom, ! [X, Y, Type] : (remaining(X, Type) <=> plus(quantity_of(X, Type), Y))).
fof(rule_4, axiom, ! [A, B] : (difference(A, B) <=> A - B)).

% --- INFERENCES ---
% From fact_2, rule_1 by Rule-1
fof(inf_1, axiom, baker_made(cakes, 84)).
% From fact_1, rule_1 by Rule-1
fof(inf_2, axiom, baker_made(pastries, 52)).
% From fact_3, rule_2 by Rule-2
fof(inf_3, axiom, baker_sold(cakes, 102)).
% From fact_4, rule_2 by Rule-2
fof(inf_4, axiom, baker_sold(pastries, 94)).
% From fact_2, rule_3 by Rule-3
fof(inf_5, axiom, remaining(cakes, 84)).
% From fact_1, rule_3 by Rule-3
fof(inf_6, axiom, remaining(pastries, 52)).
% From fact_1, rule_4 by Rule-4
fof(inf_7, axiom, difference(cakes, pastries)).
% From inf_7, rule-4 by Rule-4
fof(inf_8, axiom, more_than_difference(difference(cakes, pastries))).