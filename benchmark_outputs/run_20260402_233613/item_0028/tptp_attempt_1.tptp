% --- FACTS ---
fof(fact_1, axiom, number_of_planks(john) = 8).

% --- RULES ---
fof(rule_1, axiom, nails_per_plank = 74).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_nails = number_of_planks(john) * nails_per_plank).

% From fact_1, rule_1 by known quantities
fof(inf_2, axiom, total_nails = 8 * 74).

% Final result
fof(inf_3, axiom, total_nails = 592).