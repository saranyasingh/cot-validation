% --- FACTS ---
fof(fact_1, axiom, total_pencils(30)).

fof(fact_2, axiom, pencils_per_row(5)).

% --- RULES ---
fof(rule_1, axiom, ! [P] : (rows_can_be_made(total_pencils, pencils_per_row) => total_pencils / pencils_per_row = #rows)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, rows_can_be_made(30, 5)).