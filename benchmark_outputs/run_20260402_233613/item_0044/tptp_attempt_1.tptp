% --- FACTS ---
fof(fact_1, axiom, games(kelly, 106)).

% --- RULES ---
fof(rule_1, axiom, ! [G1, N1, G2, N2] : ((games(G1, N1) & games(G2, N2)) => remaining_games(G1, minus(N1, N2)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, remaining_games(kelly, minus(106, 64))).