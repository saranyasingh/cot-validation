% --- FACTS ---
fof(fact_1, axiom, razorback_tshirt_shop_total_revenue = 60).
fof(fact_2, axiom, razorback_tshirt_price_per_tshirt = 10).

% --- RULES ---
fof(rule_1, axiom, ! [TotalRevenue, PricePerTShirt] : ( number_of_t_shirts_sold(TotalRevenue, PricePerTShirt) = TotalRevenue / PricePerTShirt ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, number_of_t_shirts_sold(razorback_tshirt_shop_revenue(60), razorback_tshirt_price_per_tshirt(10)) = 6).