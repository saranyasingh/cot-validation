% --- FACTS ---
fof(fact_1, axiom, balloons_allan = 5).
fof(fact_2, axiom, balloons_jake = 3).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,Z] : ((X = 5 & Y = 3 & minus(X, Y) = Z) => Z = 2)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, minus(balloons_allan, balloons_jake) = 2).