% --- FACTS ---
fof(fact_1, axiom, classrooms(24)).
fof(fact_2, axiom, students(120)).

% --- RULES ---
fof(rule_1, axiom, ! [N_class, N_students, Per] : ((N_class * Per = N_students) => (Per = N_students / N_class))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, students_per_classroom(24, 120, 5)).
% From fact_1, INF-1
fof(inf_2, axiom, per_classroom(24, 5)).