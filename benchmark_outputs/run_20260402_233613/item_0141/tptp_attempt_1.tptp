% --- FACTS ---
fof(fact_1, axiom, initial_goldfish_count(paige) = 8).
fof(fact_2, axiom, remaining_goldfish_after_strays(paige) = 6).

% --- RULES ---
fof(rule_1, axiom, ! [T] : ( number_of_disappeared_goldfish(T) = initial_goldfish_count(T) - remaining_goldfish_after_strays(T) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Subtraction
fof(inf_1, axiom, number_of_disappeared_goldfish(paige) = 8 - 6).