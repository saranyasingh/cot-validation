% --- FACTS ---
fof(fact_1, axiom, roses(5) & orchids(3)).

% --- RULES ---
fof(rule_1, axiom, ! [F] : (added(F) => (is_rose(F) | is_orchid(F)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, roses(12) & orchids(2)).

% From fact_1, rule_1 by Calculation
fof(inf_2, axiom, ((roses - orchids) = 0)).

% From inf_1, inf_2 by Calculation
fof(inf_3, axiom, 2).