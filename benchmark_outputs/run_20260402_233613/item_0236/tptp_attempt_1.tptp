% --- FACTS ---
fof(fact_1, axiom, starting(fred, t_last_week) & amount(19)).
fof(fact_2, axiom, ending(fred, t_last_week) & amount(40)).
fof(fact_3, axiom, starting(jason, t_last_week) & amount(16)).
fof(fact_4, axiom, ending(jason, t_last_week) & amount(69)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ( starting(X, t_last_week) => initial_balance(X) )).
fof(rule_2, axiom, ! [X] : ( ending(X, t_last_week) => final_balance(X) )).
fof(rule_3, axiom, ! [X] : ( initial_balance(X) = final_balance(X) + net_change(X) )).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, initial_balance(fred) = 19).

% From FACT-2, RULE-2 by Modus Ponens
fof(inf_2, axiom, final_balance(fred) = 40).

% From FACT-3, RULE-1 by Modus Ponens
fof(inf_3, axiom, initial_balance(jason) = 16).

% From FACT-4, RULE-2 by Modus Ponens
fof(inf_4, axiom, final_balance(jason) = 69).

% From FACT-1, FACT-2, RULE-5 by Modus Ponens
fof(inf_5, axiom, ! [T] : ( final_balance(fred, T) + final_balance(jason, T) = final_balance(fred, t_last_week) + final_balance(jason, t_last_week) - ( initial_balance(fred) + initial_balance(jason) ) )).

% From INF-5, RULE-6 by Modus Ponens
fof(inf_6, axiom, ! [T] : ( ( final_balance(fred, T) + final_balance(jason, T) = final_balance(fred, t_last_week) + final_balance(jason, t_last_week) - ( initial_balance(fred) + initial_balance(jason) ) ) => final_balance(fred, T) = ( final_balance(fred, t_last_week) + final_balance(jason, t_last_week) - ( initial_balance(fred) + initial_balance(jason) ) ) / 2 )).

% From INF-6, substitution step
fof(inf_7, axiom, ! [T] : ( final_balance(fred, T) = (40 + 69 - (19 + 16)) / 2 )).

% From INF-7
fof(inf_8, axiom, ! [T] : ( final_balance(fred, T) = (119 - 35) / 2 )).

% From INF-8
fof(inf_9, axiom, ! [T] : ( final_balance(fred, T) = 84 / 2 )).

% From INF-9
fof(inf_10, axiom, final_balance(fred, t) = 42).