% --- FACTS ---
fof(fact_1, axiom, ! [H] : (house_receives_junk_mail(H))). 
fof(fact_2, axiom, total_junk_mail(14)). 

% --- RULES ---
fof(rule_1, axiom, ! [H] : (house_receives_junk_mail(H) => total_junk_mail >= 2 * house_receives_junk_mail(H))). 
fof(rule_2, axiom, ! [T] : (total_junk_mail(T) <=> (( ! [H] : house_receives_junk_mail(H)) & sum_house_receipts = T))). 

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [H] : (house_receives_junk_mail(H) => total_junk_mail >= 2 * house_receives_junk_mail(H))). 

% From fact_2, rule_2 by ??? 
fof(inf_2, axiom, (total_junk_mail(14) <=> (( ! [H] : house_receives_junk_mail(H)) & sum_house_receipts = 14))). 

% From inf_1, inf_2 by ??? 
fof(inf_3, axiom, (total_junk_mail(14) <=> (( ! [H] : house_receives_junk_mail(H)) & sum_house_receipts = 14))).