% --- FACTS ---
fof(fact_1, axiom, house_receives_junk_mail(house) = 2).

fof(fact_2, axiom, total_junk_mail(14)).

% --- RULES ---
fof(rule_1, axiom, ! [H] : (house_receives_junk_mail(H) => total_junk_mail >= 2 * house_receives_junk_mail(H))).

fof(rule_2, axiom, ! [T] : ( total_junk_mail(T) <=> ( ( ! [H] : house_receives_junk_mail(H) ) & ( sum_house_receives_junk_mail() ) ) = T ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, house_receives_junk_mail(house) => total_junk_mail >= 2 * house_receives_junk_mail(house)).

% From fact_2, rule_2 by (structured inference)
fof(inf_2, axiom, total_junk_mail(14) <=> ( ( ! [H] : house_receives_junk_mail(H) ) & sum_house_receives_junk_mail(H) ) = 14 ).