% --- FACTS ---
fof(fact_1, axiom, needs_sugar_for_cake(mary)).
fof(fact_2, axiom, requires_sugar(5, sugar)).

% --- RULES ---
fof(rule_1, axiom, ! [S] : (needs_sugar(S) => ? [S1] : (requires_sugar(S1, S))).
fof(rule_2, axiom, ! [F] : (flour_required(F))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, ! [M] : (mary_needs_sugar(M) => ? [M1] : (needs_sugar(M1, mary)))).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, ! [F] : (flour_required(F) => ? [F1] : (needs_sugar(F1, flour)))).
% From facts_1 and facts_2
fof(inf_3, axiom, ? [M] : ( mary_needs_sugar(M) & flour_required(flour) )).
% INF-4: Combining INF-1 and INF-2
fof(inf_4, axiom, (! [M] : (mary_needs_sugar(M) => ? [M1] : (needs_sugar(M1, mary)))) & (! [F] : (flour_required(F) => ? [F1] : (needs_sugar(F1, flour)))). 
% INF-5
fof(inf_5, axiom, needs_sugar_for_cake(mary) & flour_required(flour)).
% INF-6
fof(inf_6, axiom, negative_difference(5, 11, -6)).
% INF-7
fof(inf_7, axiom, mary_needs_to_add_fewer_sugar(6)).