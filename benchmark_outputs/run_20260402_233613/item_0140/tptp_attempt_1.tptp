% --- FACTS ---
fof(fact_1, axiom, cost_of_candy_bar(6)).
fof(fact_2, axiom, cost_of_chocolate(3)).

% --- RULES ---
fof(rule_1, axiom, ! [CandyBar] : (total_cost(CandyBar) => cost_of_candy_bar(CandyBar))).
fof(rule_2, axiom, ! [Chocolate] : (total_cost(Chocolate) => cost_of_chocolate(Chocolate))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_cost(CandyBar) => cost_of_candy_bar(CandyBar)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, total_cost(Chocolate) => cost_of_chocolate(Chocolate)).
% From inf_1, inf_2 by Subtraction
fof(inf_3, axiom, difference_in_spending(3)).