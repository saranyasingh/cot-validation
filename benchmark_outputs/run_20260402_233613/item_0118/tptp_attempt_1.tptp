% --- FACTS ---
fof(fact_1, axiom, learning_english(6)).
fof(fact_2, axiom, learning_chinese(7)).
fof(fact_3, axiom, learning_spanish(3)).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (learning_total(T) <=> (learning_english(T) + learning_chinese(T) + learning_spanish(T))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_3 by Arithmetic
fof(inf_1, axiom, 6 + 7 + 3 = 16).
% From inf_1 by Arithmetic
fof(inf_2, axiom, learning_total = 16).