% --- FACTS ---
fof(fact_1, axiom, spent(edward, 16, 92)).

% --- RULES ---
fof(rule_1, axiom, ! [N, P, M] : (spent(N, P, M) => (N * P) = M)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, price_per_book = 16/92).

% From inf_1 by simplification
fof(inf_2, axiom, price_per_book = 4/23).

% From inf_3 by substitution
fof(inf_3, axiom, initial_amount = total_expenditure + remaining_money).

% Given information
fof(inf_4, axiom, remaining_money = 6).

% Therefore
fof(inf_5, axiom, initial_amount = 22).