% --- FACTS ---
fof(fact_1, axiom, pushups(zachary, 51)).
fof(fact_2, axiom, pushups(david, 44)).

% --- RULES ---
fof(rule_1, axiom, ! [A, B, X, Y] : ((quantity(A, X) & quantity(B, Y)) => ? [Z] : (difference(Z, A, B) & quantity(Z, minus(X, Y))))).

% --- INFERENCES ---
% From FACT-1, FACT-2 by Rule-1
fof(inf_1, axiom, difference(pushups(zachary, 51), pushups(david, 44))).