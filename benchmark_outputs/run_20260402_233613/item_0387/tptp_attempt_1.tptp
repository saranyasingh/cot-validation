% --- FACTS ---
fof(fact_1, axiom, total_earnings(20, 120)).
fof(fact_2, axiom, total_earnings(16, 66)).

% --- RULES ---
fof(rule_1, axiom, ! [T, X, Y] : ( total_earnings(T, X) => ( ? [D] : ( (D < days20) & (D > 0) ) & ( ! [I] : ( ((I < D) & (I > 0)) => ( X = total_earnings(I, Y) ) ) ) ) ) ).

% --- INFERENCES ---
