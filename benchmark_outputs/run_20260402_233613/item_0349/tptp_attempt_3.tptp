% --- FACTS ---
fof(fact_1, axiom, cracker_count(matt, 23)).

fof(fact_2, axiom, cracker_count(matt, 11)).

fof(fact_3, axiom, sharing_crackers(2, matt)).

% --- RULES ---
fof(rule_1, axiom, ! [N, K, Person] : (sharing_items(N, K) => cracker_count(Person, div(N, K)))).

fof(rule_2, axiom, ! [GivenAway, GiveToFriends, InitialCrackers, Remaining] : (given_away_crackers(GivenAway, cracker_count(GiveToFriends, minus(InitialCrackers, Remaining))))) .

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, cracker_count(friend, 11.5)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, cracker_count(friend, 5.5)).

% From fact_2 and rule_1 (conclusion about each friend)
% From fact_2, rule_1 by Modus Ponens
fof(inf_3, axiom, cracker_count(each_friend, 5.5)).