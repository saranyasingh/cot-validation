% --- FACTS ---
fof(fact_1, axiom, party_in_backyard).

fof(fact_2, axiom, number_of_tables(10)).

fof(fact_3, axiom, chairs_per_set(6)).

fof(fact_4, axiom, people_on_chairs(11)).

% --- RULES ---
fof(rule_1, axiom, ! [P] : (party_in_backyard(P) => party_if_backyard(party_in_backyard(P)))).

fof(rule_2, axiom, ! [N, C] : (number_of_tables(N) & chairs_per_set(C) => number_of_chairs(N, C))).

fof(rule_3, axiom, ! [P] : (people_on_chairs(P) => chairs_occupied(P, P))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, party_if_backyard(party_in_backyard)).

% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, number_of_chairs(10, 6)).

% From fact_3, rule_2 by Modus Ponens
fof(inf_3, axiom, number_of_chairs(10, 6)).

% From fact_4, rule_3 by Modus Ponens
fof(inf_4, axiom, chairs_occupied(11, 11)).