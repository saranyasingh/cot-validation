% --- FACTS ---
fof(fact_1, axiom, total_t_shirts = 70).
fof(fact_2, axiom, packages = 14).

% --- RULES ---
fof(rule_1, axiom, ! [Q, G] : (divided_quantity(Q, G) <=> (! [I] : ((I >= 0 & I < G) => (Q / G = t_shirts(I))))) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Division
fof(inf_1, axiom, each_package = 5).