% --- FACTS ---
fof(fact_1, axiom, nails_per_plank(2)).

fof(fact_2, axiom, planks_used(16)).

% --- RULES ---
fof(rule_1, axiom, ! [PlanksUsed, NailsPerPlank] : ( (planks_used(PlanksUsed) & nails_per_plank(NailsPerPlank)) => TotalNails(PlanksUsed, NailsPerPlank) ) ).

% --- INFERENCES ---
% From fact_1, fact_2, rule_1 by Modus Ponens
fof(inf_1, axiom, TotalNails(16, 2)).