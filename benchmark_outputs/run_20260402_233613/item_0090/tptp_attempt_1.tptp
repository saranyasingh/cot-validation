% --- FACTS ---
fof(fact_1, axiom, initial_number(x) = 3).
fof(fact_2, axiom, add_action(y)).
fof(fact_3, axiom, current_number(z) = 6).

% --- RULES ---
fof(rule_1, axiom, ! [W] : ( total_after_addition(W) = x + y )).
fof(rule_2, axiom, ! [X] : ( remove_action(X) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, final_number(w) = 6).

% From fact_1, rule_2 by RuleApply
fof(inf_2, axiom, removed_count(v) = 1).

% From fact_1, rule_1 by RuleApply
fof(inf_3, axiom, total_after_addition(3) = 7).

% From inf_1, rule_2 by RuleApply
fof(inf_4, axiom, removed_count(1) = 1).