% --- FACTS ---
fof(fact_1, axiom, played_with_kids(Monday)).

fof(fact_2, axiom, played_with_kids(Tuesday)).

% --- RULES ---
fof(rule_1, axiom, ! [X,Y,Z] : ((played_with(X, Monday) & played_with(Y, Tuesday)) => total_kids(Z, X+Y))).

fof(rule_2, axiom, ! [X,Y,Z] : (total_kids(Z) <=> (played_with(X, Monday) & played_with(Y, Tuesday)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_kids(16)).

% From fact_2, rule_2 by Modus Ponens
% (Derived formula presented as total_kids(16) for consistency with the inference label)
fof(inf_2, axiom, total_kids(16)).