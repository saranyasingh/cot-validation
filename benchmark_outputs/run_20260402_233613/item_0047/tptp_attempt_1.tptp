% --- FACTS ---
fof(fact_1, axiom, fewer_peaches(jake, steven, 3)).

fof(fact_2, axiom, peaches(steven, 5)).

% --- RULES ---
fof(rule_1, axiom, (fewer_peaches(jake, steven, 3) & peaches(steven, 5)) => peaches(jake, 2)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, peaches(jake, 2)).