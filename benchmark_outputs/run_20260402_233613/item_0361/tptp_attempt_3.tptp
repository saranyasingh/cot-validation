% --- FACTS ---
fof(fact_1, axiom, total_blocks_tower = 79).
fof(fact_2, axiom, total_blocks_house = 82).

% --- RULES ---
fof(rule_1, axiom, ! [T] : ( difference(blocks_for_tower, blocks_for_house) = total_blocks_house - total_blocks_tower )).

% --- INFERENCES ---
% From fact_2, rule_1 by arithmetic evaluation
fof(inf_1, axiom, difference(82, 79) = 3).