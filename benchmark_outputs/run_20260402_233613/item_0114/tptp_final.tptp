% --- FACTS ---
fof(fact_1, axiom, regular_soda(49)).
fof(fact_2, axiom, diet_soda(40)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ( total_bottles( regular_soda(X) ) => regular_soda(X) )).
fof(rule_2, axiom, ! [Y] : ( total_bottles( diet_soda(Y) ) => diet_soda(Y) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_bottles(diet_soda(40))).

% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, total_bottles(reduced_total)).