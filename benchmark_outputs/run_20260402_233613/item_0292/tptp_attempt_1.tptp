% --- FACTS ---
fof(fact_1, axiom, large_planks(13)).
fof(fact_2, axiom, nails_per_large_plank(17)).
fof(fact_3, axiom, smaller_planks(8)).

% --- RULES ---
fof(rule_1, axiom, ! [L] : (large_planks(L) => ! [N] : (nails_per_large_plank(N) => ! [T] : (T = large => nails_needed(L)) ) ) ).
fof(rule_2, axiom, ! [S] : (smaller_planks(S) => ! [L] : (large_planks(L) => ! [N] : (nails_per_large_plank(N) => ! [T] : (T = small => nails_needed(S)) ) ) ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, nails_needed(13)).
% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, nails_per_large_plank(17)).
% From fact_3, rule_1 by Modus Ponens
fof(inf_3, axiom, smaller_planks(8)).
% From inf_1, inf_2, inf_3
fof(inf_4, axiom, nails_needed(13) & nails_per_large_plank(17) & smaller_planks(8)).