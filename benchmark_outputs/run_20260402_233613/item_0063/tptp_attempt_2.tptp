% --- FACTS ---
fof(fact_1, axiom, received_emails(4, t_morning)).
fof(fact__2, axiom, received_emails(6, t_afternoon)).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y] : ( total_received_emails() = received_emails(X, t_morning) + received_emails(Y, t_afternoon) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_received_emails() = received_emails(4, t_morning) + received_emails(6, t_afternoon)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_2, axiom, total_sent_letters() = sent_letters(2, t_morning) + sent_letters(8, t_afternoon)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_3, axiom, total_sent_letters() = sent_letters(2, t_morning) + sent_letters(8, t_afternoon)).

% From fact_2, rule_1 by Modus Ponens
fof(inf_4, axiom, total_sent_letters() = sent_letters(2, t_morning) + sent_letters(8, t_afternoon)).