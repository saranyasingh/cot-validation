% --- FACTS ---
fof(fact_1, axiom, ! [F] : (crackers_given_to(F) & ! [G] : (friend(G) => cracker_given_to(G, F)))). 
fof(fact_2, axiom, crackers_initial_amount(matthew, 36)).

% --- RULES ---
fof(rule_1, axiom, ! [A,B,C] : ((A = B) => (! [D] : (D = C) => (A + D = B + D)))). 
fof(rule_2, axiom, ! [P,Q] : (giving(P,Q) => crackers(P) > crackers(Q))). 

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, ! [X] : (friend(X) => crackers_given_to(X) = 2)).
% From FACT-2, inferred distribution
% From FACT-2, RULE-2 by Modus Ponens
fof(inf_2, axiom, ! [X] : crackers_given_to(X) = 2)).