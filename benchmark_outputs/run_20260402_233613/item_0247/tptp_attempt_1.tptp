% --- FACTS ---
fof(fact_1, axiom, NumberOfChildrenInitially = 28).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (NumberChildrenOnBus(T) => FinalNumberChildren(T) = NumberChildrenInitially + NumberChildrenOnBus(T) - NumberChildrenOffBus(T))).

% --- INFERENCES ---
% From FACT-1, RULE-1 by Modus Ponens
fof(inf_1, axiom, ! [T] : (NumberChildrenOnBus(T) - NumberChildrenOffBus(T) = 2)).

% From FACT-1, RULE-1 by Modus Ponens
fof(inf_2, axiom, ! [T] : (NumberChildrenOnBus(T) > 0)).

% From FACT-1, RULE-1 by Modus Ponens
fof(inf_3, axiom, ! [T] : (NumberChildrenOffBus(T) > 0)).

% From inf_1, inf_2, inf_3 by Existential Generalization
fof(inf_4, axiom, ? [Y] : (Y > 0 & NumberChildrenOnBus(Y) - NumberChildrenOffBus(Y) = 2)).