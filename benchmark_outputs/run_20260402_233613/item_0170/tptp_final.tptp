% --- FACTS ---
fof(fact_1, axiom, number_of_cookies_paco(40)).

% --- RULES ---
fof(rule_1, axiom, ! [C] : ((number_of_cookies_paco(C) > 0) => (number_of_cookies_paco(C) - 5))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, number_of_cookies_paco(35)).

% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, number_of_cookies_paco(22)).