% --- FACTS ---
fof(fact_1, axiom, selling_t_shirts_for(215, t_shirt)).

% --- RULES ---
fof(rule_1, axiom, ! [P] : (selling_t_shirts_for(P, t_shirt) => total_revenue_from_selling_t_shirts(P))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_revenue_from_selling_t_shirts(215)).

% From INF-1, Rule-1
fof(inf_2, axiom, selling_t_shirts_for(215, t_shirt) => total_revenue_from_selling_t_shirts(215)).

% From INF-2, Rule-1 again
fof(inf_3, axiom, total_revenue(total_revenue_from_selling_t_shirts(215))).