% --- FACTS ---
fof(fact_1, axiom, received_money(gwen, mom, 7)).
fof(fact_2, axiom, received_money(gwen, dad, 5)).

% --- RULES ---
fof(rule_1, axiom, ! [G, P] : (total_amount(gwen, parents) = dad_money + mom_money)).
fof(rule_2, axiom, ! [A] : (remaining_money_after_spending(gwen, parents, A) = total_money(gwen, parents) - A)).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, total_amount(gwen, parents) = dad_money + mom_money).

% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, remaining_money_after_spending(gwen, parents, 4) = total_money(gwen, parents) - 4).

% From inf_2, arithmetic by evaluation
% From inf_2, arithmetic by evaluation
fof(inf_3, axiom, difference_between_mom_and_dad_money = (total_amount(gwen, parents) - amount_spent) - (total_amount(gwen, parents) - amount_spent)).

% From inf_3, arithmetic by evaluation
fof(inf_4, axiom, difference_between_mom_and_dad_money = 8).