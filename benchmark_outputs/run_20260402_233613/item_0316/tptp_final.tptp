% --- FACTS ---
fof(fact_1, axiom, tag_played_with_kids(5, monday)).

fof(fact_2, axiom, tag_played_with_kids(x, tuesday)).

% --- RULES ---
fof(rule_1, axiom, ! [N] : ( ! [M] : (tag_played_with_kids(N, monday) => tag_played_with_kids(N+M, tuesday)) )).

% --- INFERENCES ---
% From fact_1, rule_1 by Universal Generalization
fof(inf_1, axiom, ! [Y] : (tag_played_with_kids(Y, monday) => Y + tag_played_with_kids(Y + x, tuesday))).

% From fact_2, rule_1 by Universal Generalization
fof(inf_2, axiom, ! [Z] : (tag_played_with_kids(Z, tuesday) => Z + tag_played_with_kids(Z + 5, monday))).

% From fact_1, fact_2, rule_1 by Universal Generalization
fof(inf_3, axiom, ! [W] : (TotalTagPlayers(W) = 15)).

% From inf_1, inf_2 by Universal Instantiation
fof(inf_4, axiom, (tag_played_with_kids(5, monday) => tag_played_with_kids(5 + x, tuesday))).