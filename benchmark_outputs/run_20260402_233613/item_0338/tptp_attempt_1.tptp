% --- FACTS ---
fof(fact_1, axiom, sacks_harvested_daily = 76).
fof(fact_2, axiom, sacks_discarded_daily = 64).

% --- RULES ---
fof(rule_1, axiom, ! [TOTAL_HARVESTED] : ((sacks_harvested_daily = TOTAL_HARVESTED) => (sacks_remaining_after_discard(TOTAL_HARVESTED, sacks_discarded_daily) = TOTAL_HARVESTED - sacks_discarded_daily))).

% --- INFERENCES ---
% From fact_1, fact_2 by Modus Ponens
fof(inf_1, axiom, sacks_remaining_after_discard(76, 64) = 12).
% From fact_1 (and arithmetic with 50 oranges per sack)
fof(inf_2, axiom, total_oranges_harvested_daily = sacks_harvested_daily * 50).