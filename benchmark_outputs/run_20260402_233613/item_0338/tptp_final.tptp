% --- FACTS ---
fof(fact_1, axiom, sacks_harvested_daily = 76).
fof(fact_2, axiom, sacks_discarded_daily = 64).

% --- RULES ---
fof(rule_1, axiom, ! [SH, SD] : ( sacks_remaining_after_discard(SH, SD) = (SH - SD) ) ).

% --- INFERENCES ---
