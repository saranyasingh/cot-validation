% --- FACTS ---
fof(fact_1, axiom, wax_needed(628, 628)).

fof(fact_2, axiom, ! [W] : (wax_present(W))).

fof(fact_3, axiom, additional_wax(159)).

% --- RULES ---
fof(rule_1, axiom, ! [F, W] : ( total_wax_required(F, W, 628) => F + W = 628 )).

% --- INFERENCES ---
