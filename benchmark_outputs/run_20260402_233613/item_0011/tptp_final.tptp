% --- FACTS ---
fof(fact_1, axiom, app_count(dave, t_0) = 15).
fof(fact_2, axiom, new_apps_added(dave) = 71).

% --- RULES ---
fof(rule_1, axiom, ! [X, Y, Z] : (delete_apps(X, Y, Z) => X - Y = Z)).

% --- INFERENCES ---
% From fact_1, fact_2 by Rule-1
fof(inf_1, axiom, delete_apps(15, 71, 86)).
% From fact_2 by assignment
fof(inf_2, axiom, final_app_count(dave) = 14).
% From inf_1, inf_2 by arithmetic
fof(inf_3, axiom, difference_in_apps(86, 14) = 86 - 14).
% From inf_3 by substitution
fof(inf_4, axiom, number_deleted_apps = difference_in_apps(86, 14)).
% From inf_4 by evaluation
fof(inf_5, axiom, check_if_correctly_calculated(delete_apps(86, 14, 72)) = true).