% --- FACTS ---
fof(fact_1, axiom, has_beads(emily, 6)).

% --- RULES ---
fof(rule_1, axiom, ! [X, N, Y] : ((has_beads(X, N) & necklace_required_per_necklace(Y)) => (number_of_necklaces_can_be_made(X, Y) = quotient(N, Y)))).

