% --- FACTS ---
fof(fact_1, axiom, page_count(chapter_1) = 31).

% --- RULES ---
fof(rule_1, axiom, ! [T] : ((page_count(chapter_2) = 36) => ( minus(total_pages, page_count(chapter_2)) = page_count(chapter_1) ))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, page_count(chapter_1) = minus(total_pages, page_count(chapter_2))).