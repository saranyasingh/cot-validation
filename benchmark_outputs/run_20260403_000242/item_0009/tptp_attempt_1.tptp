% --- FACTS ---
fof(fact_1, axiom, tickets_spent(dave, 12)).
fof(fact_2, axiom, tickets_left(dave, 14)).

% --- RULES ---
fof(rule_1, axiom, ! [N, L] : ((tickets_spent(dave, N) & tickets_left(dave, L)) => tickets_won(dave, add(N, L)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, tickets_won(dave, add(12, 14))).

% From fact_1, fact_2 by arithmetic
fof(inf_2, axiom, tickets_won(dave, 26)).