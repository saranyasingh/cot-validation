% --- FACTS ---
fof(fact_1, axiom, book_count(books, 7)).
fof(fact_2, axiom, action_figure_count(action_figures, 3)).

% --- RULES ---
fof(rule_1, axiom, ! [T] : (add(item_added, item_count))).

% --- INFERENCES ---
% From fact_2, rule_1 by Modus Ponens
fof(inf_1, axiom, action_figure_count(updated_action_figures, 5)).
% From fact_1, inf_1 by Modus Ponens
fof(inf_2, axiom, (book_count(books, 7) & action_figure_count(updated_action_figures, 5)) => (book_count(books, 7) - action_figure_count(updated_action_figures, 5))).