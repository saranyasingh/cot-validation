% --- FACTS ---
fof(fact_1, axiom, lost_weight(jessie, 126)).
fof(fact_2, axiom, current_weight(jessie, 66)).

% --- RULES ---
fof(rule_1, axiom, ! [P, W, C] : (lost_weight(P, W) => decreases_weight(W, C))).
fof(rule_2, axiom, ! [I, L, F] : (calculate_initial_weight(I, L, F))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, final_weight_after_loss(66, 126)).
% From fact_2, rule_2 by Modus Ponens
fof(inf_2, axiom, OriginalWeight(126, 66, 192)).
% From fact_2, rule_2 by Calculation
fof(inf_3, axiom, OriginalWeightCalculation(192, 126, 66)).