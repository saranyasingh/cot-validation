% --- FACTS ---
fof(fact_1, axiom, initial_apps(15)).
fof(fact_2, axiom, added_apps(71)).
fof(fact_3, axiom, total_apps_after_adding(86)).
fof(fact_4, axiom, remaining_apps(14)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ! [Y] : ( initial_apps(X) & added_apps(Y) => total_apps_after_adding(plus(X,Y)) ) ).
fof(rule_2, axiom, ! [TOTAL] : ! [K] : ( ( total_apps(TOTAL) & deleted_apps(K) ) => new_total( minus(TOTAL, K) ) ) ).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, minus(15,71) = -56).
% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, minus(0, plus(minus(15,71), 71)) = -15).
% From fact_3, fact_4 by Arithmetic
fof(inf_3, axiom, minus(minus(86,14), 71) = 1).