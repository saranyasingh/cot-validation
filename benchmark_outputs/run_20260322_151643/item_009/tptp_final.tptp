% --- FACTS ---
fof(fact_1, axiom, used_tickets(dave, number_12)).
fof(fact_2, axiom, has_left_after_using(dave, number_14, number_12)).

% --- RULES ---
fof(rule_1, axiom, ! [P] : ((used_tickets(P, number_12) & has_left_after_using(P, number_14, number_12)) => initial_tickets(P, number_26))).

% --- INFERENCES ---
% From fact_1, fact_2 by Conjunction Introduction
fof(inf_1, axiom, used_tickets(dave, number_12) & has_left_after_using(dave, number_14, number_12)).
% From inf_1, rule_1 by Modus Ponens
fof(inf_2, axiom, initial_tickets(dave, number_26)).