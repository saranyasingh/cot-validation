% --- FACTS ---
fof(fact_1, axiom, current_weight(jessie, w_66)).
fof(fact_2, axiom, weight_lost(jessie, w_126)).
fof(fact_3, axiom, plus(w_66, w_126, w_192)).

% --- RULES ---
fof(rule_1, axiom, ! [P, C, L, W] : ((current_weight(P, C) & weight_lost(P, L) & plus(C, L, W)) => initial_weight(P, W))).

% --- INFERENCES ---
% From fact_1, fact_2, fact_3, rule_1 by Modus Ponens and Universal Instantiation
fof(inf_1, axiom, initial_weight(jessie, w_192)).