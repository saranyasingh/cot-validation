% --- FACTS ---
fof(fact_1, axiom, book_chapters(book, 3)).
fof(fact_2, axiom, book_total_pages(book, 594)).

% --- RULES ---
fof(rule_1, axiom, ! [B, P, T] : ((book_chapters(B, 3) & pages_per_chapter(B, P) & book_total_pages(B, T)) => (T = 3 * P))).
fof(rule_2, axiom, ! [B, T] : ((book_chapters(B, 3) & book_total_pages(B, T)) => ? [P] : (pages_per_chapter(B, P) & T = 3 * P))).

% --- INFERENCES ---
% From fact_2, rule_2 by Modus Ponens
fof(inf_1, axiom, ? [P] : (pages_per_chapter(book, P) & 594 = 3 * P)).
% From inf_1 by Arithmetic Solving
fof(inf_2, axiom, pages_per_chapter(book, 198)).
% From inf_2 by Arithmetic Solving
fof(inf_3, axiom, pages_per_chapter(book, 198)).