% --- FACTS ---
fof(fact_1, axiom, equals(dad_strawberries, n_11)).
fof(fact_2, axiom, sum_equals(marco_strawberries, dad_strawberries, n_30)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : ! [Y] : (sum_equals(X, Y, n_30) & equals(Y, n_11) => equals(X, w_19))).

% --- INFERENCES ---
% From fact_2, fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, equals(marco_strawberries, w_19)).