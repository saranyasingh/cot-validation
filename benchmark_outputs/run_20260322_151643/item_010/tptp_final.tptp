% --- FACTS ---
fof(fact_1, axiom, total_books(thirty_four)).
fof(fact_2, axiom, bookshelves(two)).
fof(fact_3, axiom, equally_distributed(thirty_four, two, bookshelves)).
fof(fact_4, axiom, divides(thirty_four, two, seventeen)).

% --- RULES ---
fof(rule_1, axiom, ! [T, K, C, N] : ((equally_distributed(T, K, C) & divides(T, K, N)) => per_container_items(C, N))).

% --- INFERENCES ---
% From fact_3, fact_4, rule_1 by Modus Ponens
fof(inf_1, axiom, per_container_items(bookshelves, seventeen)).