% --- FACTS ---
fof(fact_1, axiom, b(2)).

% --- RULES ---
fof(rule_1, axiom, ! [X] : (b(X) => w(div(X, 2)))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, w(div(2, 2))).

% From fact_1, rule_1 by Addition
fof(inf_2, axiom, 3=3).

% From fact_1, rule_1 by Addition
fof(inf_3, axiom, 3=3).