% --- FACTS ---
fof(fact_1, axiom, laying(duck, 16, t_0)).

% --- RULES ---
fof(rule_1, axiom, ! [N,E,C] : (laying(N, E, t_0) => eggs_consumed(C, t_0))).
fof(rule_2, axiom, ! [M] : (baking(M, t_0) => eggs_used(M, t_0))).
fof(rule_3, axiom, ! [R] : (egg_sold(R, t_0) => earns_money(R, t_0))).

% --- INFERENCES ---
% From fact_1, rule_1 by Modus Ponens
fof(inf_1, axiom, laying(duck, 16, t_0)).
% From fact_1, rule_1 by Modus Ponens
fof(inf_2, axiom, eggs_consumed(3, t_0)).
% From fact_1, rule_2 by Modus Ponens
fof(inf_3, axiom, eggs_used(4, t_0)).
% From fact_1, rule_3 by Modus Ponens
fof(inf_4, axiom, egg_sold(2, t_0)).
% From fact_1, rule_1 by Modus Ponens
fof(inf_5, axiom, laying(duck, 16, t_0)).
% From fact_1, rule_1 by Modus Ponens
fof(inf_6, axiom, eggs_consumed(3, t_0)).
% From fact_1, rule_2 by Modus Ponens
fof(inf_7, axiom, eggs_used(4, t_0)).
% From fact_1, rule_3 by Modus Ponens
fof(inf_8, axiom, egg_sold(2, t_0)).
% From fact_1, rule_3 by Modus Ponens
fof(inf_9, axiom, earns_money(18, t_0)).